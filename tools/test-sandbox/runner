#!/usr/bin/env bash
# runner — cargo's target runner (.cargo/config.toml): every test binary runs under bubblewrap,
# where it cannot see the caller's installation.
#
#   runner BINARY [ARGS...]               what cargo calls
#   runner --print-args BINARY [ARGS...]  the bwrap command line, one argument per line
#   runner --around CMD [ARGS...]         CMD once inside one such sandbox (the gate's nextest run),
#                                         its environment kept and each target/<d> link destination
#                                         writable; every test binary it spawns then finds itself held
#
# The policy is testenv's sandbox unit runner's (testenv/src/sandbox.rs, Profile::bwrap_args):
# read-only root; tmpfs /tmp, /run and home; the toolchain bound back; the workspace and
# CARGO_TARGET_DIR writable; the environment cleared to an allow-list; no network. `--around` adds
# one writable bind per target/<d> link destination and keeps the caller's environment. Every directory the home already holds comes back
# empty and writable, so a write to the install lands in tmpfs and never on disk. It differs in
# hiding both $HOME and the passwd entry's home.
#
# No fallback: without an executable bwrap it refuses and runs nothing. The one binary run as
# is, is a `cargo run` artifact, which cargo places beside .fingerprint (test harnesses live in
# deps/).
set -uo pipefail

die() { echo "test-sandbox: $*" >&2; exit 2; }

print="" around=""
if [ "${1:-}" = "--print-args" ]; then print=1; shift; fi
if [ "${1:-}" = "--around" ]; then around=1; shift; fi
[ $# -ge 1 ] || die "usage: runner [--print-args] BINARY [ARGS...] | runner [--print-args] --around CMD [ARGS...]"
bin="$1"
if [ -z "$around" ]; then
    [ -x "$bin" ] || die "$bin is not an executable file"
    bindir="$(cd "$(dirname "$bin")" && pwd -P)" || die "cannot resolve the directory of $bin"
    bin="$bindir/$(basename "$bin")"

    if [ -z "$print" ] && [ -d "$bindir/.fingerprint" ]; then
        exec "$@"
    fi
fi

[ -n "${HOME:-}" ] && [ "${HOME#/}" != "$HOME" ] || die "HOME is not an absolute path; it names the tree to hide"
home="$(cd "$HOME" && pwd -P)" || die "HOME=$HOME does not exist"
[ "$home" != / ] || die "HOME is /; hiding it would hide the root"
# The passwd entry's home is hidden too: a caller that sets HOME to a fixture still has a real
# home a test could reach by its absolute path.
trees=("$home")
pw="$(getent passwd "$(id -u)" | cut -d: -f6)"
if [ -n "$pw" ] && [ -d "$pw" ]; then
    pw="$(cd "$pw" && pwd -P)"
    [ "$pw" = "$home" ] || [ "$pw" = / ] || trees+=("$pw")
fi

# Already inside a sandbox that holds the policy (testenv's runs cargo under bwrap, and a
# kernel confining bwrap's children refuses a nested user namespace): read from the kernel,
# not from a variable — root read-only, every hidden home and /run a tmpfs, only loopback.
# Then no mounts are left to make; the environment is cleared and the binary runs in place.
held() {
    local root="" runfs="" mp opts rest fs if t
    local -A fsat=()
    while read -r _ _ _ _ mp opts rest; do
        rest=" $rest" fs="${rest#* - }" fs="${fs%% *}"
        fsat[$mp]="$fs"
        [ "$mp" = / ] && case ",$opts," in *,ro,*) root=ro ;; *) root="" ;; esac
    done < /proc/self/mountinfo
    [ "$root" = ro ] && [ "${fsat[/run]:-}" = tmpfs ] || return 1
    for t in "${trees[@]}"; do [ "${fsat[$t]:-}" = tmpfs ] || return 1; done
    while IFS=: read -r if _; do
        if="${if// /}"
        case "$if" in Inter-* | face* | lo) ;; *) return 1 ;; esac
    done < /proc/net/dev
}

# RUST_TEST_THREADS=1 prints no hung line, so silence is bounded too.
bounded() {
    local w1 w2 tmp pid rc=0 limit="" period="" periods="" line name="" why="" now last start tee_out tee_err
    tmp="$(mktemp -d)" || die "cannot make a scratch directory"
    mkfifo "$tmp/tick" && exec 9<>"$tmp/tick" || die "cannot make a wait fifo"
    if [ -r "$workspace/.config/nextest.toml" ]; then
        while IFS= read -r line; do
            [[ $line =~ period\ *=\ *\"([0-9]+)s\" ]] && period="${BASH_REMATCH[1]}"
            [[ $line =~ terminate-after\ *=\ *([0-9]+) ]] && periods="${BASH_REMATCH[1]}"
        done < "$workspace/.config/nextest.toml"
        [ -n "$period" ] && [ -n "$periods" ] && limit=$((period * periods * 1000000))
    fi
    printf '%s' "${EPOCHREALTIME/./}" > "$tmp/act"
    local watch='while IFS= read -r l || [ -n "$l" ]; do
        [[ $l =~ ^test\ (.*)\ has\ been\ running\ for\ over\ [0-9]+\ seconds$ ]] && printf "%s" "${BASH_REMATCH[1]}" > "$2/hung"
        printf "%s" "${EPOCHREALTIME/./}" > "$2/act"
    done'
    mkfifo "$tmp/out" "$tmp/err" "$tmp/w1" "$tmp/w2" || die "cannot make the stream fifos"
    bash -c "$watch" _ x "$tmp" < "$tmp/w1" &
    w1=$!
    bash -c "$watch" _ x "$tmp" < "$tmp/w2" &
    w2=$!
    tee "$tmp/w1" < "$tmp/out" &
    tee_out=$!
    tee "$tmp/w2" < "$tmp/err" >&2 &
    tee_err=$!
    setsid "$@" <&0 > "$tmp/out" 2> "$tmp/err" &
    pid=$!
    kill_tree() {
        local p all=("$pid") i=0
        while [ $i -lt ${#all[@]} ]; do
            for p in $(ps -o pid= --ppid "${all[$i]}" 2>/dev/null); do all+=("$p"); done
            i=$((i + 1))
        done
        kill -KILL -- "-$pid" "${all[@]}" 2>/dev/null
    }
    trap 'kill_tree; rm -rf "$tmp"; exit 143' TERM INT HUP
    start=${EPOCHREALTIME/./}
    while kill -0 "$pid" 2>/dev/null; do
        if [ -s "$tmp/hung" ]; then why=libtest; name="$(<"$tmp/hung")"; break; fi
        if [ -n "$limit" ]; then
            now=${EPOCHREALTIME/./}
            last="$(<"$tmp/act")"
            [ "$last" -ge "$start" ] 2>/dev/null || last=$start
            if [ $((now - last)) -ge "$limit" ]; then why=silent; name=-; break; fi
        fi
        read -r -t 0.05 -u 9 _ || true
    done
    if [ -n "$why" ]; then
        kill_tree
        wait "$pid" 2>/dev/null
        echo "test-sandbox: HUNG test=$name binary=${bin##*/}" >&2
        rc=124
    else
        wait "$pid"; rc=$?
    fi
    wait "$tee_out" "$tee_err" "$w1" "$w2" 2>/dev/null
    trap - TERM INT HUP
    rm -rf "$tmp"
    exit "$rc"
}

is_held=""
[ -z "$print" ] && held && is_held=1
# The command is found on the PATH it was handed, then run by that absolute path: the sandbox's
# home is a tmpfs, and bwrap's own lookup would not see what was bound back after it.
if [ -n "$around" ]; then
    cmd="$(command -v -- "$1")" && [ "${cmd#/}" != "$cmd" ] && [ -x "$cmd" ] && [ ! -d "$cmd" ] ||
        { echo "test-sandbox: --around: $1 is not on PATH (${PATH:-})" >&2; exit 75; }
    shift
    set -- "$cmd" "$@"
fi
[ -n "$around" ] && [ -n "$is_held" ] && exec "$@"
supervise=""
[ -z "$around" ] && [ -z "$print" ] && [ -z "${NEXTEST:-}" ] && supervise=1


path="$home/.local/lib/spira-env/bin:${CARGO_HOME:+$CARGO_HOME/bin:}/usr/local/bin:/usr/bin:/bin"
[ -n "${CARGO:-}" ] && path="$(dirname "$CARGO"):$path"

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
workspace="$(cd "$HERE/../.." && pwd -P)"

# The target is the one CARGO_TARGET_DIR declares; unset, cargo's own is in the workspace.
target="${CARGO_TARGET_DIR:-}"
if [ -n "$target" ]; then
    [ "${target#/}" != "$target" ] || die "CARGO_TARGET_DIR=$target is relative; cargo resolved it from a directory this runner is not in"
    target="$(cd "$target" && pwd -P)" || die "CARGO_TARGET_DIR=$CARGO_TARGET_DIR does not exist"
fi

# testenv's system git identity (GIT_IDENTITY), lowest priority, on the sandbox's /run.
gitconfig=/run/test-sandbox/gitconfig
handed=""
if [ -n "$is_held" ] && [ -n "${GIT_CONFIG_SYSTEM:-}" ] && [ -r "$GIT_CONFIG_SYSTEM" ] && [ -f "$GIT_CONFIG_SYSTEM" ] &&
    grep -Eq '^[[:space:]]*name[[:space:]]*=' "$GIT_CONFIG_SYSTEM" && grep -Eq '^[[:space:]]*email[[:space:]]*=' "$GIT_CONFIG_SYSTEM"; then
    gitconfig="$GIT_CONFIG_SYSTEM"
    handed=1
fi
env=()
setenv() { env+=("$1=$2"); }
setenv PATH "$path"
setenv HOME "$home"
setenv USER "${home##*/}"
setenv TMPDIR /tmp
setenv LANG C.UTF-8
setenv CARGO_NET_OFFLINE true
setenv CARGO_TERM_COLOR never
# .cargo/config.toml's [env] value, which cargo does not apply over a caller's exported one.
setenv SPIRA_HOME "$workspace/spira"
[ -n "$target" ] && setenv CARGO_TARGET_DIR "$target"
setenv GIT_CONFIG_SYSTEM "$gitconfig"
while IFS= read -r k; do
    case "$k" in
        CARGO_HOME | RUSTUP_HOME | RUSTUP_TOOLCHAIN | \
            CARGO | CARGO_MANIFEST_DIR | CARGO_MANIFEST_PATH | CARGO_CRATE_NAME | CARGO_BIN_NAME | \
            CARGO_PRIMARY_PACKAGE | CARGO_PKG_* | CARGO_BIN_EXE_* | \
            LD_LIBRARY_PATH | \
            RUST_TEST_* | RUST_BACKTRACE | RUST_LIB_BACKTRACE | RUST_MIN_STACK | RUST_LOG)
            setenv "$k" "${!k}" ;;
    esac
done < <(compgen -e)

identity='[user]\n\tname = spirauser\n\temail = spirauser@localhost\n'
printf -v identity_text "$identity"

if [ -n "$is_held" ]; then
    # An enclosing runner's sandbox may have handed it in already, read-only.
    IFS= read -r -d '' current < "$gitconfig" 2>/dev/null
    if [ -z "$handed" ] && [ "$current" != "$identity_text" ]; then
        mkdir -p "${gitconfig%/*}" && printf "$identity" > "$gitconfig.$$" && mv -f "$gitconfig.$$" "$gitconfig" ||
            die "cannot write $gitconfig in ${gitconfig%/*} as $(id -un)"
    fi
    [ -n "$supervise" ] && bounded /usr/bin/env -i "${env[@]}" "$@"
    exec /usr/bin/env -i "${env[@]}" "$@"
fi

# The toolchain is where rustup's proxy (and the testenv image) declare it; unset, none of it
# is bound in and a test that needs it fails inside.
ro=() rw=()
[ -n "${RUSTUP_HOME:-}" ] && ro+=("$RUSTUP_HOME")
# Cargo's own default home, as cargo resolves it, when the caller declared none.
cargo_home="${CARGO_HOME:-}"
[ -z "$cargo_home" ] && [ -n "$around" ] && cargo_home="$home/.cargo"
[ -n "$cargo_home" ] && ro+=("$cargo_home/bin") && rw+=("$cargo_home/registry" "$cargo_home/git")
# The config (profiles, incremental) decides every unit's fingerprint, so a cargo inside must read the box's.
[ -n "$cargo_home" ] && ro+=("$cargo_home/config.toml" "$cargo_home/config")
# Without a declared RUSTUP_HOME (cargo started straight from a toolchain, not through rustup's
# proxy, as the round VM does) the toolchain is still bound by where it really is: $CARGO, and
# what $CARGO_HOME/bin's cargo and rustc link to. Binding bin alone leaves those links dangling
# when the toolchain sits under a hidden home, and a test that spawns $CARGO finds nothing. A
# link that resolves to rustup itself names no toolchain and binds nothing here; rustup's own
# default home is bound for it instead.
toolchain_of() {
    local r
    r="$(readlink -f "$1" 2>/dev/null)" && [ -f "$r" ] && [ "${r##*/}" = "${1##*/}" ] && [ "${r%/bin/*}" != "$r" ] &&
        printf '%s\n' "${r%/bin/*}"
}
if [ -z "${RUSTUP_HOME:-}" ]; then
    for b in ${CARGO:+"$CARGO"} ${cargo_home:+"$cargo_home/bin/cargo" "$cargo_home/bin/rustc"}; do
        # Never CARGO_HOME itself (a cargo installed straight into its bin): it holds credentials.
        t="$(toolchain_of "$b")" && [ "$t" != "$cargo_home" ] && ro+=("$t")
    done
    [ -d "$home/.rustup" ] && ro+=("$home/.rustup")
fi
if [ -n "$around" ]; then
    t="$(toolchain_of "$1")" && [ "$t" != "$cargo_home" ] && ro+=("$t")
fi
ro+=("$home/.local/lib/spira-env")
# bwrap comes from the system directories alone, never the caller's PATH or the toolchain's.
bwrap=""
for d in /usr/local/bin /usr/bin /bin; do
    [ -f "$d/bwrap" ] && [ -x "$d/bwrap" ] && { bwrap="$d/bwrap"; break; }
done
[ -n "$bwrap" ] || [ -n "$print" ] || die "bwrap (bubblewrap) is not on /usr/local/bin:/usr/bin:/bin; refusing to run $1 outside a sandbox"

under() { [ "${1#"$2"/}" != "$1" ]; }
under_tree() { local t; for t in "${trees[@]}"; do under "$1" "$t" && return 0; done; return 1; }

a=(--die-with-parent --new-session --unshare-user --unshare-pid --unshare-ipc --unshare-uts
   --unshare-net --unshare-cgroup-try
   --ro-bind / / --dev /dev --proc /proc --tmpfs /tmp --tmpfs /run)
# A binary outside the workspace and target (rustdoc's doctests, under TMPDIR) is bound in
# read-only: before the home tmpfs when it holds a home, after the shadows when under one.
# A harness in deps/ or examples/ execs its package's binaries from the profile directory above it
# (CARGO_BIN_EXE_*), so that directory is what comes in, not deps/ alone.
late_bin=""
if [ -z "$around" ]; then
    bindroot="$bindir"
    case "${bindir##*/}" in deps | examples) bindroot="${bindir%/*}" ;; esac
    if ! under "$bindir/" "$workspace" && ! { [ -n "$target" ] && under "$bindir" "$target"; }; then
        if under_tree "$bindir"; then late_bin=1; else a+=(--ro-bind "$bindroot" "$bindroot"); fi
    fi
fi
# Each shadow goes on before what is bound back beneath it.
shadows=()
for t in "${trees[@]}"; do
    a+=(--tmpfs "$t")
    for d in "$t"/* "$t"/.[!.]* "$t"/..?*; do
        [ -d "$d" ] && [ ! -L "$d" ] && [ "$d" != "$workspace" ] && [ "$d" != "$target" ] && shadows+=("$d")
    done
done
for d in "${shadows[@]}"; do a+=(--tmpfs "$d"); done
for r in "${ro[@]}"; do [ -e "$r" ] && a+=(--ro-bind "$r" "$r"); done
for r in "${rw[@]}"; do [ -e "$r" ] && a+=(--bind "$r" "$r"); done
nogit=""
if [ -f "$workspace/.git" ]; then
    gitdir="$(sed -n 's/^gitdir: *//p' "$workspace/.git")"
    case "$gitdir" in /*) ;; *) gitdir="$workspace/$gitdir" ;; esac
    case "$gitdir" in */worktrees/*) gitdir="${gitdir%/worktrees/*}" ;; esac
    # Refused only where a sandbox is made: a held one has no mounts to make.
    if [ -d "$gitdir" ]; then a+=(--ro-bind "$gitdir" "$gitdir"); else nogit="$workspace/.git names $gitdir, which does not exist"; fi
fi
a+=(--bind "$workspace" "$workspace")
if [ -n "$target" ] && ! under "$target" "$workspace"; then a+=(--bind "$target" "$target"); fi
if [ -n "$late_bin" ]; then a+=(--ro-bind "$bindroot" "$bindroot"); fi
# The build directories a gate tree links out of its target are written by the cargo run inside.
if [ -n "$around" ]; then
    for d in "$workspace"/target/*; do
        [ -L "$d" ] && l="$(readlink -f "$d")" && [ -d "$l" ] && ! under "$l" "$workspace" && a+=(--bind "$l" "$l")
    done
fi
a+=(--chdir "$PWD")


# With no network sccache cannot start, which fails every rustc probe. Empty, not unset: unset
# lets the bound cargo config name a wrapper the sandbox hides.
if [ -n "$around" ]; then
    a+=(--setenv RUSTC_WRAPPER "")
    env=(GIT_CONFIG_SYSTEM="$gitconfig")
else
    a+=(--clearenv --setenv RUSTC_WRAPPER "")
fi
if [ -n "$print" ]; then
    printf '%s\n' bwrap "${a[@]}"
    for kv in "${env[@]}"; do printf -- '--setenv\n%s\n%s\n' "${kv%%=*}" "${kv#*=}"; done
    printf '%s\n' -- "$@"
    exit 0
fi
[ -z "$nogit" ] || die "$nogit"
for kv in "${env[@]}"; do a+=(--setenv "${kv%%=*}" "${kv#*=}"); done
if [ -n "$supervise" ]; then
    exec 3< <(printf "$identity")
    bounded "$bwrap" "${a[@]}" --ro-bind-data 3 "$gitconfig" -- "$@"
fi
exec "$bwrap" "${a[@]}" --ro-bind-data 3 "$gitconfig" -- "$@" 3< <(printf "$identity")
