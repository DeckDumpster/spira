# gate.steps — the certification gate of this repository (gate/DESIGN.md "The tree owns its
# gate", sp-quu2w). The gate reads THIS file from the tree it judges — the branch merged onto
# its landing ref — and the base trial reads the landing ref's own copy. Production config
# holds no gate string: a branch that ports, adds or deletes a fence edits this file in the
# same commit, and its own gate runs exactly what it would land with.
#
# One directive per line, so a fence port is a one-line diff:
#   step <command>          one element of the `&&` chain, in order
#   bin <VAR> <package>     build <package> from this tree (cargo, aeon profile) before any
#                           step, and give the steps $VAR = that binary instead of the
#                           installed one — so a rule a branch adds to it runs on that branch
#   # comment, blank line   ignored
#
# Every `step bash <path>` must name a file this tree carries (the gate refuses the branch
# otherwise, and `cargo test -p gate` checks it). Every fence prints
# `fence: <name> checked <n> <unit>` with n > 0 (DESIGN.md "Every fence proves it checked").
# A unit composition drops the `step bash spira/build-fence.sh` line (its build phase is the
# compile check, sp-aprxm); keep it a line of its own.

bin SPIRA_LINT_BIN spira-lint

step bash spira/inventory.sh
step bash spira/literal-lint.sh
step bash spira/scratch-fence.sh
step "$SPIRA_LINT_BIN"
step bash spira/testdb-mode-lint.sh
step bash spira/bd-stdin-lint.sh
step bash spira/gh-intake-lint.sh
step bash spira/incident-cause-lint.sh
step bash spira/tmux-scope-fence.sh
step bash spira/wiki-add-fence.sh
step bash spira/build-fence.sh

# The suite selector and the budgeted suite run; `|| exit 1` refuses a selector that failed
# (an empty selection from a broken selector is not "nothing to run").
step { _s="$(bash spira/gate-touched.sh "$SPIRA_GATE_BASE" "${SPIRA_GATE_SELECT_HEAD:-$SPIRA_GATE_BRANCH}")" || exit 1; [ -n "$_s" ] || exit 0; _b=0; "$SPIRA_TESTENV_BIN" --deadline "${SPIRA_GATE_BUDGET:-300}" --suites "${_s//$'\n'/,}" "$SPIRA_GATE_BRANCH" || _b=$?; case "$_b" in 2|3) exit 75;; *) exit "$_b";; esac; }
