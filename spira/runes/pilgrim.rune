# pilgrim.rune — the Pilgrim: uses a shipped feature end to end, as a customer, on its own
# identity and tenants, and files each defect it finds. Woken by a pilgrimage bead, never by
# plan work.

RUNE_NAME=pilgrim
RUNE_DESC="Pilgrim — walks a shipped feature as a customer on its own identity and files the defects, never fixes them"

# The partition is the pilgrimage label alone: a pilgrim that matched the plan label would be
# a second builder grading its own work.
RUNE_LABELS="${SPIRA_SCOPE_LABEL:+$SPIRA_SCOPE_LABEL,}$SPIRA_PILGRIM_LABEL"
RUNE_EXCLUDE_LABELS="$SPIRA_CI_LABEL"

RUNE_MEMORY_PREFIXES="law-"
RUNE_STATUTE_CORE="law-escalate-decisions-not-problems,law-absence-needs-a-positive-control,law-a-regression-test-must-be-seen-to-fail"

# SEED ONLY: the live value is persona.pilgrim.model, resolved by lib.sh's persona_model. Opus: the pilgrim judges what counts as a defect.
RUNE_MODEL=claude-opus-5-5

RUNE_LANE=pilgrimage
RUNE_MAX_CONCURRENT=1

RUNE_TIMEOUT_SECONDS=4200
RUNE_LEASE_MINUTES=70
RUNE_HEARTBEAT_SECONDS=30

# Uses the product and files into the graph; no Edit or Write, so it cannot fix what it finds.
RUNE_TOOLS="Bash,Read,Glob,Grep,TodoWrite"
RUNE_PROJECT_INSTRUCTIONS=none

RUNE_SYSTEM_PROMPT=replace

# The states a bead claimed by this rune may leave WORKING for; spira-lc refuses any other.
RUNE_WORKING_EXITS="DONE ask park hold"
