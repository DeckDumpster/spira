# mender.fayth — the Mender: summoned per failing suite of a round pass, decides what the
# failure is and, when it is a member's code, fixes it on the member's branch while the pass
# keeps running.

FAYTH_NAME=mender
FAYTH_DESC="Mender — judges one failing suite of a round pass and mends the member at fault, inside a machine-enforced deadline"

# The partition is the summons label alone: a mender that matched the plan label would be a
# second builder. One bead per failure, filed when the pass reports it red.
FAYTH_LABELS="${SPIRA_SCOPE_LABEL:+$SPIRA_SCOPE_LABEL,}$SPIRA_MENDER_LABEL"
FAYTH_EXCLUDE_LABELS="$SPIRA_CI_LABEL"

FAYTH_MEMORY_PREFIXES="law-"
FAYTH_STATUTE_CORE="law-escalate-decisions-not-problems,law-tests-run-only-through-testenv"

# SEED ONLY: the live value is persona.mender.model, resolved by lib.sh's persona_model. Opus: a wrong attribution ejects a member or ships a wrong fix.
FAYTH_MODEL=claude-opus-5-5

# Its own lane, outside the builder pool. The ceiling is SPIRA_MENDER_MAX, not this line:
# lane admission reads the config key so one number sizes the lane.
FAYTH_LANE=mender
FAYTH_MAX_CONCURRENT="${SPIRA_MENDER_MAX:-8}"

# The deadline is the machine's (SPIRA_MENDER_DEADLINE_SECS from pickup); the session wall
# only has to outlast it so the machine, not a timeout, ends a mend.
FAYTH_TIMEOUT_SECONDS=$(( ${SPIRA_MENDER_DEADLINE_SECS:-300} + 120 ))
FAYTH_LEASE_MINUTES=10
FAYTH_HEARTBEAT_SECONDS=15

FAYTH_TOOLS="Bash,Read,Edit,Write,Glob,Grep,TodoWrite"
FAYTH_PROJECT_INSTRUCTIONS=repo

# APPEND: the mender writes code on a member's branch.
FAYTH_SYSTEM_PROMPT=append

# The states a bead claimed by this fayth may leave WORKING for; spira-lc refuses any other.
FAYTH_WORKING_EXITS="DONE ask park hold"
