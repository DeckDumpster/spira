# spira.conf.example — annotated template. Copy to spira.conf and fill in what applies.
#
# Three sources, first to speak wins: the ENVIRONMENT (the test-fixture seam), then this
# FILE, then a DEFAULT derived from where the harness is installed. A clean clone with no
# config at all resolves to sensible defaults; set only what differs on your box.
#
# Parsed, not sourced. KEY = value, # comments, unknown keys are reported and ignored.
# Quotes are stripped; ~ and $HOME expand; nothing else does.
#
# Keys not listed here are refused. Typos are reported, not silently obeyed.

# ---- PROMOTION MODEL ------------------------------------------------------------------
#
# This harness supports two layouts. Pick one; everything else follows from it.
#
# SPLIT-CHECKOUT MODEL (the default assumption)
# SPIRA_PROD resolves to a separate clone that systemd executes. The development checkout
# (SPIRA_REPO) is where aeons work; promote.sh carries commits across to production.
# The default derives from your checkout location:
#
#   SPIRA_PROD = /path/to/<harness-repo>-prod/<harness-subdir>
#
# Set it explicitly if your prod clone lives elsewhere:
#
# SPIRA_PROD = /opt/spira-harness-prod/spira
#
# SINGLE-CHECKOUT MODEL
# SPIRA_PROD inside SPIRA_REPO means one checkout serves as both development and
# production. The landing pass is what advances the copy in force; promote.sh will
# exit non-zero and point you to skew.sh refresh. If this is your layout, set:
#
# SPIRA_PROD = $SPIRA_HOME
#
# (or leave SPIRA_PROD unset and let the default derive a split-checkout path, then
# never call promote.sh — skew.sh refresh is the right tool in single-checkout mode)

# ---- DATABASE -------------------------------------------------------------------------
# Where the beads database lives. Must NOT be inside the harness checkout (a git add -A
# would publish your internal working notes). Default: $HOME/.local/share/spira/db
#
# SPIRA_DB = ~/.local/share/spira/db

# ---- RUNTIME --------------------------------------------------------------------------
# Leases, logs, worktrees. Default: $SPIRA_REPO/.runtime/spira
#
# SPIRA_RUN = ~/.local/run/spira

# ---- PATH EXTENSIONS ------------------------------------------------------------------
# Prepended to PATH before every tool call. Use this to make bd, claude, gh, etc.
# available when this harness runs from systemd, where your login PATH does not exist.
#
# SPIRA_PATH = ~/.local/bin:/usr/local/bin

# ---- AGENT ----------------------------------------------------------------------------
# The Claude CLI binary. Default: claude
#
# SPIRA_AGENT = claude

# ---- BEADS DATABASE PIN ---------------------------------------------------------------
# Pinned bd binary path. Resolves to first bd on SPIRA_PATH + system PATH when unset.
#
# SPIRA_BD = ~/.local/bin/bd

# ---- GOAL EPIC ------------------------------------------------------------------------
# The bead id of the goal epic for this installation. Default: sp-spira
#
# SPIRA_GOAL = sp-spira

# ---- REPOSITORIES ---------------------------------------------------------------------
# Parent directory of all checkouts. Default: parent of SPIRA_REPO.
#
# SPIRA_WORKSPACES = /workspaces

# ---- COCKPIT --------------------------------------------------------------------------
# Where the cockpit panes and tools live. Default: sibling of the harness subdir.
#
# SPIRA_COCKPIT = /path/to/cockpit

# ---- OPTIONAL INTEGRATIONS ------------------------------------------------------------
# Gas Town beads store. Leave empty if you do not have one.
# SPIRA_TOWN =

# Obsidian wiki checkout for cross-linking. Leave empty if unused.
# SPIRA_WIKI =

# Dolt server data directory. Leave empty if you manage the server yourself.
# SPIRA_DOLT_DATA =

# ---- PERSONAS -------------------------------------------------------------------------
# Which fayths this host runs, space-separated. Default: every .fayth in the chamber.
#
# SPIRA_FAYTHS = builder ops

# Maximum aeons in the task pool. Default: 4
#
# SPIRA_MAX_AEONS = 4

# Maximum aeons alive at once across all personas. Unset by default (no ceiling).
#
# SPIRA_MAX_LIVE_AEONS = 6

# ---- GITHUB APP IDENTITY ---------------------------------------------------------------
# When set, git pushes from the harness are attributed to the App rather than to the
# operator's SSH key. Set SPIRA_GH_APP_ID and SPIRA_GH_APP_INSTALLATION_ID here (or in
# SPIRA_GH_APP_CONFIG), and point SPIRA_GH_APP_KEY at the private key PEM file.
# See spira/git-credential-app.sh for credential resolution order.
#
# SPIRA_GH_APP_ID = 12345
# SPIRA_GH_APP_INSTALLATION_ID = 67890
# SPIRA_GH_APP_KEY = ~/.config/spira/github-app-key.pem
# SPIRA_GH_APP_CONFIG = ~/.config/spira/github-app.env

# ---- TIMEZONE -------------------------------------------------------------------------
# Dates in logs and escalations. Empty means the host's local zone.
#
# SPIRA_TZ = America/Los_Angeles
