# spira/testenv/Containerfile — Ubuntu 24.04 with system and user systemd,
# Rust, and every dependency the manifest in deps.toml declares.
#
# THE IMAGE IS VERIFIED, NOT ASSERTED. After installation, doctor-check.sh reads conf.sh's
# deps.toml manifest, tiered by spira_bin_tier, and fails the build on any runtime-tier
# absence or any un-waived optional/operator-tier absence. A program added to the manifest
# fails this build until the image carries it — the mechanism is self-maintaining in the
# right direction.
#
# SIZING. Only what the tests need to run against. The caller's checkout is
# bind-mounted by testenv.sh at /workspace; this image provides only the runtime.
#
# BUILD CONTEXT. The build context is spira/ (the harness root), set by
# testenv.sh's -f flag. COPY paths below are relative to that root.
#
# MULTI-STAGE. Two builder stages keep heavy build dependencies out of the
# runtime image.
#
# bd-builder: Go toolchain (~245 MB), source clone, module cache and build
#   cache (~3 GB combined). None are used at runtime; only the compiled binary
#   crosses into the runtime stage. rm -rf in a later layer never shrinks an
#   image — only not writing the bytes does.
#
# rust-builder: rustup installer and any download cache. The toolchain itself
#   must survive into the runtime image because build.sh compiles
#   $SPIRA_REPO/loom at runtime from a bind-mounted candidate branch and the
#   source does not exist at image-build time. So the builder stage is used for
#   ACQUISITION only — installer and caches are discarded, toolchain is copied.

# ── Stage 1: build bd ─────────────────────────────────────────────────────────
FROM docker.io/library/ubuntu:24.04 AS bd-builder

ENV DEBIAN_FRONTEND=noninteractive

ARG GO_VERSION=1.26.5
ARG BD_TAG=v1.2.1
ARG BD_REPO=https://github.com/steveyegge/beads.git

# Minimal toolchain for the build: curl+ca-certificates to download Go,
# git to clone the source, build-essential for CGO_ENABLED=1 (gcc).
RUN apt-get update -q && \
    apt-get install -yq --no-install-recommends \
        curl \
        ca-certificates \
        git \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL -o /tmp/go.tar.gz \
    "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" && \
    tar -C /usr/local -xzf /tmp/go.tar.gz && \
    rm /tmp/go.tar.gz

# CGO_ENABLED=1: embedded Dolt is opened through cgo; a pure-Go build refuses
# at runtime. -tags gms_pure_go: avoids ICU linking failures via go-mysql-server.
# /out/bd is the only artifact that crosses into the runtime stage. The Go
# toolchain, source clone, module cache, and build cache are all discarded with
# this builder stage.
RUN mkdir /out && \
    git clone --depth 1 --branch "${BD_TAG}" "${BD_REPO}" /tmp/bd-src && \
    cd /tmp/bd-src && \
    CGO_ENABLED=1 /usr/local/go/bin/go build -tags gms_pure_go -o /out/bd ./cmd/bd

# ── Stage 2: acquire Rust toolchain via rustup ────────────────────────────────
# ACQUISITION ONLY. The rustup installer, its download cache, and the registry
# cache are discarded by the cleanup step and never reach the runtime image.
#
# The toolchain must survive into the runtime image — build.sh compiles
# $SPIRA_REPO/loom at runtime from a bind-mounted candidate branch and the
# source does not exist at image-build time. This differs from the bd-builder
# stage, which is discarded whole because bd is compiled once from a pinned
# tag and only the binary is needed afterwards.
FROM docker.io/library/ubuntu:24.04 AS rust-builder
ARG RUST_VERSION=1.96.0
RUN apt-get update -q && \
    apt-get install -yq --no-install-recommends curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain "$RUST_VERSION" \
                     --no-modify-path && \
    rm -rf /root/.cargo/registry /root/.rustup/downloads

# ── Stage 3: runtime image ────────────────────────────────────────────────────
FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# ── Rust toolchain from the builder stage ──────────────────────────────────
# /usr/local/cargo: rustup bin shims (cargo, rustc, rustup, …).
# /usr/local/rustup: compiler toolchains; RUSTUP_HOME points here so every
#   rustup proxy resolves to the correct version.
# CARGO_HOME (set below to /var/spira/cargo) is a separate path used for
#   project-level crate registries and build artefacts — it is not where the
#   toolchain binaries live, and no apt cargo or rustc is installed alongside.
COPY --from=rust-builder /root/.cargo /usr/local/cargo
COPY --from=rust-builder /root/.rustup /usr/local/rustup
ENV RUSTUP_HOME=/usr/local/rustup \
    PATH=/usr/local/cargo/bin:$PATH

# ── Base: system init, session bus, core tools ─────────────────────────────
# All from the distro archive; no external download scripts.
# python3 and git: required by install.sh (template rendering, repo root detection).
# flock: serialises writers sharing one path — landing gate per-repository tree.
# Rust is provided above via rustup; cargo and rustc are NOT installed from apt
#   so that only one compiler exists on PATH.
# tmux: cockpit panes; doctor.sh WARN.
# inotify-tools: provides inotifywait; test-mail-deliver.sh exercises the real binary.
# aerc: test-mail-deliver.sh and related suites use it as a stub target.
# nodejs: gate the browser page's view model; test-loom-page.sh exits 0 with SKIP
#         when node is absent, making syntax errors in loom/static/ permanently
#         invisible. This is the hard argument for including it.
# build-essential: gcc for cargo's C linker when compiling Rust crates.
# curl+ca-certificates: download gh and dolt release archives.
# locales: locale-gen; suites need a UTF-8 locale for string operations.
# inotify-tools/aerc: installed above; comments updated there.
RUN apt-get update -q && \
    apt-get install -yq --no-install-recommends \
        systemd \
        systemd-sysv \
        systemd-logind \
        dbus \
        dbus-user-session \
        sudo \
        python3 \
        git \
        curl \
        ca-certificates \
        gpg \
        build-essential \
        tmux \
        inotify-tools \
        aerc \
        nodejs \
        locales \
        inotify-tools \
        aerc \
    && rm -rf /var/lib/apt/lists/*

# ── Locale — suites need a UTF-8 locale for string operations ─────────────
# Without this, LANG and LC_ALL are unset and LC_CTYPE defaults to C, which
# refuses multi-byte characters in tools that respect the locale.
RUN locale-gen en_US.UTF-8
ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

# ── Git identity — embedded bd init and suites that commit need an author ──
# bd init creates an initial commit; git refuses without user.name/user.email.
# A missing identity makes _testdb_embedded_check fail, which cascades to every
# suite that calls testdb_up (no embedded mode and SPIRA_DOLT_DATA empty = no
# server mode either — suite exits non-zero rather than 77).
# System-level config is read by all users including spirauser.
RUN git config --system user.email "spirauser@localhost" && \
    git config --system user.name "spirauser"

# ── gh — GitHub CLI ────────────────────────────────────────────────────────
# Official GitHub CLI apt repository. Pinned to the stable channel rather than
# a specific version so security patches arrive without a Containerfile edit.
RUN mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        | gpg --dearmor -o /etc/apt/keyrings/githubcli.gpg && \
    chmod go+r /etc/apt/keyrings/githubcli.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli.gpg] \
https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list && \
    apt-get update -q && \
    apt-get install -yq --no-install-recommends gh && \
    rm -rf /var/lib/apt/lists/*

# ── dolt — SQL server for bd's server-backed testdb mode ──────────────────
# Pinned to the same version as the operator's install to avoid schema drift
# between server and client during server-mode test runs.
ARG DOLT_VERSION=2.2.3
RUN curl -fsSL -o /tmp/dolt.tar.gz \
    "https://github.com/dolthub/dolt/releases/download/v${DOLT_VERSION}/dolt-linux-amd64.tar.gz" && \
    tar -C /tmp -xzf /tmp/dolt.tar.gz && \
    install -m 0755 /tmp/dolt-linux-amd64/bin/dolt /usr/local/bin/dolt && \
    rm -rf /tmp/dolt.tar.gz /tmp/dolt-linux-amd64

# ── duckdb — the query layer over run/tsd/'s JSONL files (sp-sbc6o) ───────────────────────
# A single static binary from the project's own GitHub releases; gzip-compressed, no package
# manager involved. Runtime-tier in deps.toml: tsd-query.sh has no fallback path, so an
# image without it fails the doctor-check step below rather than shipping a silent gap.
ARG DUCKDB_VERSION=1.5.5
RUN curl -fsSL -o /tmp/duckdb.gz \
    "https://github.com/duckdb/duckdb/releases/download/v${DUCKDB_VERSION}/duckdb_cli-linux-amd64.gz" && \
    gunzip -c /tmp/duckdb.gz > /usr/local/bin/duckdb && \
    chmod 0755 /usr/local/bin/duckdb && \
    rm -f /tmp/duckdb.gz

# ── aws CLI v2 ────────────────────────────────────────────────────────────
# Required when the runner pool spills to EC2. Installed system-wide.
# Key fingerprint: FB5D B77F D5C1 18B8 0511 ADA8 A631 0ACC 4672 475C
# Key embedded from keyserver.ubuntu.com — awscli.amazonaws.com/awscli.pub
# returns 404 as of 2026-09-23; the embedded key avoids the external dependency.
ARG AWS_CLI_VERSION=2.37.1
COPY testenv/awscli.pub /tmp/awscli.pub
RUN apt-get update -q && \
    apt-get install -yq --no-install-recommends unzip && \
    rm -rf /var/lib/apt/lists/* && \
    curl -fsSL -o /tmp/awscliv2.zip \
        "https://awscli.amazonaws.com/awscli-exe-linux-x86_64-${AWS_CLI_VERSION}.zip" && \
    curl -fsSL -o /tmp/awscliv2.zip.sig \
        "https://awscli.amazonaws.com/awscli-exe-linux-x86_64-${AWS_CLI_VERSION}.zip.sig" && \
    mkdir -p /tmp/.gnupg && chmod 700 /tmp/.gnupg && \
    GNUPGHOME=/tmp/.gnupg gpg --batch --no-autostart --import /tmp/awscli.pub && \
    GNUPGHOME=/tmp/.gnupg gpg --batch --no-autostart --verify /tmp/awscliv2.zip.sig /tmp/awscliv2.zip && \
    unzip -q /tmp/awscliv2.zip -d /tmp && \
    /tmp/aws/install --install-dir /usr/local/aws-cli --bin-dir /usr/local/bin && \
    rm -rf /tmp/aws /tmp/awscliv2.zip /tmp/awscliv2.zip.sig /tmp/awscli.pub /tmp/.gnupg

# ── bd — copied from builder stage ────────────────────────────────────────
# The bd-builder stage compiled bd and was then discarded: Go toolchain,
# source clone, and both Go caches (~3 GB combined) never appear in this layer.
# Both bd and bd-embedded are installed: testdb.sh checks for bd-embedded by name.
COPY --from=bd-builder /out/bd /usr/local/bin/bd
RUN install -m 0755 /usr/local/bin/bd /usr/local/bin/bd-embedded

# ── claude stub — satisfies 'command -v claude' checks ────────────────────
# concierge.sh calls spira_require claude before any subcommand dispatch,
# including the 'brief' subcommand that test-concierge.sh drives. A missing
# claude is a hard refusal — not a degraded run — so the test fails even for
# the sections that never invoke a real session. The stub satisfies the check;
# any actual session invocation exits 127 so the failure is visible, not silent.
RUN printf '#!/bin/sh\n# testenv stub: satisfies command -v claude and spira_require claude.\n# Not a real Claude installation. Exits non-zero when invoked as a session.\nprintf "claude: testenv container stub; not a real installation\\n" >&2\nexit 127\n' \
    > /usr/local/bin/claude && chmod 0755 /usr/local/bin/claude

# ── doctor-check: image is verified, not asserted ─────────────────────────
# COPY conf.sh (the manifest) and the check script into a scratch location. Run the check
# to verify every manifest program is present or explicitly waived.
# The scripts are deleted after; they are a build-time gate, not a runtime tool.
COPY conf.sh /tmp/doctor-check/conf.sh
COPY deps.toml /tmp/doctor-check/deps.toml
COPY testenv/doctor-check.sh /tmp/doctor-check/doctor-check.sh
COPY testenv/doctor-waivers /tmp/doctor-check/doctor-waivers
RUN bash /tmp/doctor-check/doctor-check.sh \
        /tmp/doctor-check/conf.sh \
        /tmp/doctor-check/doctor-waivers && \
    rm -rf /tmp/doctor-check

# ── spirauser — non-root user the tests run as ─────────────────────────────
# A fixed UID keeps the cargo cache volume owner stable across image rebuilds.
RUN useradd -m -s /bin/bash -u 1001 spirauser && \
    echo 'spirauser ALL=(ALL) NOPASSWD: /usr/bin/systemctl' \
         > /etc/sudoers.d/spirauser-systemctl && \
    chmod 0440 /etc/sudoers.d/spirauser-systemctl

# CARGO_HOME outside any user home directory so the volume path avoids a literal
# that inventory.sh would flag. The directory is created owned by spirauser so it
# is writable from the container's first command without a privilege step.
ENV CARGO_HOME=/var/spira/cargo
RUN mkdir -p /var/spira/cargo /workspace && \
    chown -R spirauser:spirauser /var/spira/cargo /workspace

# Mask services that require privileges the rootless container does not hold.
# Masking prevents failed-unit churn during systemd startup and does not prevent
# the services from being unmasked later inside the container.
RUN systemctl mask \
        systemd-networkd.service \
        systemd-resolved.service \
        NetworkManager.service \
        apt-daily.service apt-daily.timer \
        apt-daily-upgrade.service apt-daily-upgrade.timer \
        e2scrub_reap.service \
        motd-news.service motd-news.timer \
    2>/dev/null; true

WORKDIR /workspace

# systemd expects SIGRTMIN+3 as its clean shutdown signal. --systemd=true in the
# podman run invocation sets this automatically; the STOPSIGNAL declaration makes
# the intent visible here regardless of how the container is started.
STOPSIGNAL SIGRTMIN+3

CMD ["/lib/systemd/systemd"]
