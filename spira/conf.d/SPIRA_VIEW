TYPE=string
GROUP=view
DOC=The cockpit view program: builds and syncs the attention surface; empty switches the runtime view follower off.
DEFAULT<<'SPIRA_CONF_DEFAULT_EOF'
    # THE VIEW FOLLOWER: the program that builds and syncs the attention surface the operator
    # looks at. Empty means this installation has none, and spira-runtime's view handler, which
    # follows review state and flips that surface, schedules nothing.
    #
    # THE CONTRACT IT MUST MEET:
    #   <prog> build    ensure the surface exists
    #   <prog> sync     show the view review state calls for
    : "${SPIRA_VIEW:=}"
SPIRA_CONF_DEFAULT_EOF
