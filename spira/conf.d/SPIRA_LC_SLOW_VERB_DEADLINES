TYPE=string
GROUP=lc
DOC=Store verbs declared slower than the default request deadline, as `verb=ms@bead` entries separated by commas; each names its own deadline and the bead that fixes it. A `watch` entry is ignored: a watch is cut at the hold its caller asked for plus 500 ms. Edit only through `spira-lc deadline lower --verb`.
DEFAULT<<'SPIRA_CONF_DEFAULT_EOF'
    : "${SPIRA_LC_SLOW_VERB_DEADLINES:=}"
SPIRA_CONF_DEFAULT_EOF
