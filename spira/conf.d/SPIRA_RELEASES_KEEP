TYPE=string
GROUP=releases
DOC=HOW MANY RELEASES TO KEEP. Old releases beyond this count are pruned after each
DEFAULT<<'SPIRA_CONF_DEFAULT_EOF'
    # HOW MANY RELEASES TO KEEP. Old releases beyond this count are pruned after each
    # activation (best-effort; a prune failure never fails the activation). Each release
    # tree is about 120 MB, so the count is the disk bill; current and the rollback target are
    # never pruned whatever this says.
    : "${SPIRA_RELEASES_KEEP:=10}"
SPIRA_CONF_DEFAULT_EOF
