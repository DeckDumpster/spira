TYPE=u32
GROUP=local
DOC=Unpublished commits on a queue.local repo past which the backlog alarm fires, once the oldest of them is older than one publish cycle (30 min).
DEFAULT<<'SPIRA_CONF_DEFAULT_EOF'
    # THE UNPUBLISHED-BACKLOG ALARM (publish-backlog.sh, row 5 of the local/main design):
    # a queue.local repo's local/main is alarmed to the concierge when it holds more than
    # this many commits the publish queue has not yet pushed to the forge, and the oldest of
    # them is older than one publish cycle (30 min): a round landing in one burst is not behind.
    : "${SPIRA_LOCAL_BACKLOG_COUNT:=50}"
SPIRA_CONF_DEFAULT_EOF
