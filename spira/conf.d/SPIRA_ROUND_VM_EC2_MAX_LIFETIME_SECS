TYPE=u64
GROUP=round
DOC=Seconds after launch by which an EC2 spill VM has shut itself down (its user-data schedules the power-off ten minutes earlier, for boot and the terminate), so one past it is proven dead even when its state cannot be read. A knob that must exceed SPIRA_ROUND_PASS_WALL_MAX_SECS plus teardown plus that margin; at the pass wall plus an hour, re-taken with it.
DEFAULT<<'SPIRA_CONF_DEFAULT_EOF'
    # Seconds after launch an EC2 spill VM shuts itself down; past it, it is proven dead.
    : "${SPIRA_ROUND_VM_EC2_MAX_LIFETIME_SECS:=10800}"
SPIRA_CONF_DEFAULT_EOF
