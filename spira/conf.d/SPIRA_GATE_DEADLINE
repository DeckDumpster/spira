DOC=THE GATE'S TEST DEADLINE, in seconds: the tests only; tools, fences and builds are not charged
DEFAULT<<'SPIRA_CONF_DEFAULT_EOF'
    # THE GATE'S TEST DEADLINE, in seconds: the tests only; tools, fences and builds are not charged.
