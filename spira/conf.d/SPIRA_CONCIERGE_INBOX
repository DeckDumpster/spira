TYPE=string
GROUP=concierge
DOC=THE CONCIERGE'S DURABLE INBOX. Every watcher and mail-deliver appends one line here
DEFAULT<<'SPIRA_CONF_DEFAULT_EOF'
    # THE CONCIERGE'S DURABLE INBOX. Every watcher and mail-deliver appends one line here
