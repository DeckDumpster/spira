TYPE=string
GROUP=flow
DOC=SPIRA_FLOW_UNOBSERVABLE_GRACE_SECS — seconds a blind flow detector may stand before it alerts.
SCHEMA=Seconds the flow detector may be unable to observe (query layer unreachable) before it alerts; deliberately independent of flow_grace_secs (unit: seconds; integer; default 3600; sane range 900-14400). Parsed as an integer, so it must not be empty.
DEFAULT<<'SPIRA_CONF_DEFAULT_EOF'
    : "${SPIRA_FLOW_UNOBSERVABLE_GRACE_SECS:=3600}"
SPIRA_CONF_DEFAULT_EOF
