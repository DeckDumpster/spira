TYPE=bool
GROUP=runtime
DOC=Whether this spira-runtime's cockpit tier tasks write run/cockpit.env.
SCHEMA=Whether this spira-runtime's three cockpit tier tasks are the one writer of run/cockpit.env and its history row. Set it to 0 on a scheduler that must not write, so only one instance does. On by default.
DEFAULT<<'SPIRA_CONF_DEFAULT_EOF'
    : "${SPIRA_RUNTIME_COCKPIT_TIER_WRITE:=1}"
SPIRA_CONF_DEFAULT_EOF
