TYPE=u64
GROUP=heimdall
DOC=Seconds a live builder's transcript may stay unwritten while its commands use no CPU before Heimdall raises builder-still:<bead>.
DEFAULT<<'SPIRA_CONF_DEFAULT_EOF'
    # A builder whose transcript is unwritten and whose descendants are idle this long is a
    # command waiting on nothing the builder can see.
    : "${SPIRA_HEIMDALL_STILL_SECS:=180}"
SPIRA_CONF_DEFAULT_EOF
