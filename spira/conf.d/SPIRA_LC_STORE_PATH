TYPE=string
GROUP=lc
DOC=Path of the control-plane state store (SQLite), made by spira-lc admin-create-store, that lc-serve opens. Set, spira-lc serves watch, section, intent, lock, pass, publish-section and rc from it; the bead-state verbs move to it only with SPIRA_LC_LIFECYCLE_ON_STORE on as well. Empty, every verb that needs the store answers cannot-tell and every other verb stays on the dolt lifecycle store.
DEFAULT<<'SPIRA_CONF_DEFAULT_EOF'
    : "${SPIRA_LC_STORE_PATH:=}"
SPIRA_CONF_DEFAULT_EOF
