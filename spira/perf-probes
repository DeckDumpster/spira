# perf-watch probes: <name><TAB><command>. Each is a frequently invoked read-only path, timed end to end.
lc-list	spira-lc list --live
lc-show	spira-lc show sp-perf-probe
lc-ops-view	spira-lc ops-view ops_live
work-list	work list --json
# claim-check is a dwarf's ready read: the same judgement bulk-ready-by-rune makes, without
# its verdict publish, which is a write (~140-350 ms of group commit; the probe ran 400-1600 ms
# with it and ~215 ms without, 2026-11-01). sp-s5ndy5.
claim-check	spira-claim rune-ready builder --json
lc-ready	spira-lc list --state READY
# content-read is the content door a builder's submit goes through; a store that cannot answer it
# is UNRUNNABLE here instead of silent until a builder asks.
content-read	spira-lc content show sp-perf-probe
