{
  "uid": "spira-goodput",
  "title": "Spira goodput",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "tags": [
    "spira"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_VM",
        "type": "datasource",
        "query": "prometheus",
        "label": "data source"
      },
      {
        "name": "repo",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_VM}"
        },
        "label": "repo",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "query": {
          "query": "label_values(spira_goodput_rate, repo)",
          "refId": "v"
        },
        "refresh": 2
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "goodput rate per day, trailing 24 h unhalted",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "last_over_time(spira_goodput_rate{repo=~\"$repo\",window=\"24h\"}[$__interval])",
          "legendFormat": "{{repo}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "landed per day, trailing 24 h unhalted",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "last_over_time(spira_goodput_landed{repo=~\"$repo\",window=\"24h\"}[$__interval])",
          "legendFormat": "{{repo}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "goodput ratio, 1 h and 24 h",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "last_over_time(spira_goodput_ratio{repo=~\"$repo\"}[$__interval])",
          "legendFormat": "{{repo}} {{window}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "goodput rate per day, last hour",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "last_over_time(spira_goodput_rate{repo=~\"$repo\",window=\"1h\"}[$__interval])",
          "legendFormat": "{{repo}}",
          "refId": "A"
        }
      ]
    }
  ]
}
