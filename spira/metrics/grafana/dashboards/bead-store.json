{
  "uid": "spira-bead-store",
  "title": "Bead store calls",
  "tags": [
    "spira"
  ],
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "editable": false,
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Call rate by verb",
      "datasource": {
        "type": "prometheus",
        "uid": "spira-vm"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "spira-vm"
          },
          "expr": "sum by (rpc_method) (rate(traces_span_metrics_calls_total{service_name=\"spira-lc\"}[5m]))",
          "legendFormat": "{{rpc_method}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latency p50 / p95",
      "datasource": {
        "type": "prometheus",
        "uid": "spira-vm"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "spira-vm"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"spira-lc\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "spira-vm"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"spira-lc\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errors by verb",
      "datasource": {
        "type": "prometheus",
        "uid": "spira-vm"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "spira-vm"
          },
          "expr": "sum by (rpc_method) (rate(traces_span_metrics_calls_total{service_name=\"spira-lc\",status_code=\"STATUS_CODE_ERROR\"}[5m]))",
          "legendFormat": "{{rpc_method}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Call rate by caller",
      "datasource": {
        "type": "prometheus",
        "uid": "spira-vm"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "spira-vm"
          },
          "expr": "sum by (spira_caller) (rate(traces_span_metrics_calls_total{service_name=\"spira-lc\"}[5m]))",
          "legendFormat": "{{spira_caller}}"
        }
      ]
    }
  ]
}
