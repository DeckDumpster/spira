{
  "uid": "spira-bead-store",
  "title": "Spira bead store",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "tags": [
    "spira"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_VM",
        "type": "datasource",
        "query": "prometheus",
        "label": "data source"
      },
      {
        "name": "verb",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_VM}"
        },
        "label": "verb",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "query": {
          "query": "label_values(spira_bead_store_calls, verb)",
          "refId": "v"
        },
        "refresh": 2
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "calls per interval by verb",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (verb) (sum_over_time(spira_bead_store_calls{verb=~\"$verb\"}[$__interval]))",
          "legendFormat": "{{verb}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "latency p50 by verb",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "quantile_over_time(0.5, spira_bead_store_call_seconds{verb=~\"$verb\"}[$__interval])",
          "legendFormat": "{{verb}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "latency p90 by verb",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "quantile_over_time(0.9, spira_bead_store_call_seconds{verb=~\"$verb\"}[$__interval])",
          "legendFormat": "{{verb}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "latency p99 by verb",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "quantile_over_time(0.99, spira_bead_store_call_seconds{verb=~\"$verb\"}[$__interval])",
          "legendFormat": "{{verb}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "state-store bench: CAS write latency (p50, p99, p99.9, max)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "max_over_time(spira_state_store_bench_cas_p50_seconds[$__interval])",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "max_over_time(spira_state_store_bench_cas_p99_seconds[$__interval])",
          "legendFormat": "p99",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "max_over_time(spira_state_store_bench_cas_p999_seconds[$__interval])",
          "legendFormat": "p99.9",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "max_over_time(spira_state_store_bench_cas_max_seconds[$__interval])",
          "legendFormat": "max",
          "refId": "D"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "hot reads through the CLI, end to end (perf-watch): p50 over the last hour, by probe",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "quantile_over_time(0.5, spira_perf_watch_probe_seconds[1h])",
          "legendFormat": "{{probe}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "control store off-box: age of the oldest unshipped object (alarm past SPIRA_LC_SHIP_MAX_AGE_SECS)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "max_over_time(spira_lc_ship_oldest_unshipped_seconds[$__interval])",
          "legendFormat": "oldest unshipped",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "store calls by task",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (caller, task) (sum_over_time(spira_lc_requests{verb=~\"$verb\"}[$__interval]))",
          "legendFormat": "{{caller}} {{task}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "store time by task",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 8,
        "y": 40,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (caller, task) (sum_over_time(spira_lc_request_seconds{verb=~\"$verb\"}[$__interval]))",
          "legendFormat": "{{caller}} {{task}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Calls over SPIRA_LC_ANSWER_MS by verb",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 16,
        "y": 40,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (verb) (sum_over_time(spira_lc_requests_over{verb=~\"$verb\"}[$__interval]))",
          "legendFormat": "{{verb}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "lc-serve restart to ready (bound: 2 s)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2000
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "max_over_time(spira_lc_ready_ms[$__interval])",
          "legendFormat": "ready after",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "lc-serve resident memory (bound: 200 MB)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 209715200
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "max_over_time(spira_lc_rss_bytes[$__interval])",
          "legendFormat": "rss",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "control store: commits since the last completed WAL checkpoint (crash-loss bound is the JUMP in state-store-sqlite)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "max_over_time(spira_state_store_uncheckpointed_commits[$__interval])",
          "legendFormat": "uncheckpointed commits",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "control store WAL size",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 8388608 },
              { "color": "red", "value": 9437184 }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "max_over_time(spira_state_store_wal_bytes[$__interval])",
          "legendFormat": "wal bytes",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "control store WAL resets per hour",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum(sum_over_time(spira_state_store_wal_resets_completed[1h]))",
          "legendFormat": "completed",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum(sum_over_time(spira_state_store_wal_resets_given_up[1h]))",
          "legendFormat": "given up",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum(sum_over_time(spira_state_store_wal_forced_resets[1h]))",
          "legendFormat": "forced",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum(sum_over_time(spira_state_store_wal_forced_given_up[1h]))",
          "legendFormat": "forced, given up",
          "refId": "D"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "control store reads ended by a WAL reset by verb (expected 0)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 6,
        "y": 64,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (verb) (sum_over_time(spira_lc_reads_ended_by_reset[$__interval]))",
          "legendFormat": "ended by a reset (expected 0) {{verb}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "control store reads ended at the limit by verb",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 12,
        "y": 64,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (verb) (sum_over_time(spira_lc_reads_ended[$__interval]))",
          "legendFormat": "ended {{verb}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (verb) (sum_over_time(spira_lc_reads_overran[$__interval]))",
          "legendFormat": "overran (expected 0) {{verb}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "control store longest gate wait by verb",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 18,
        "y": 64,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.1 }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "max by (verb) (max_over_time(spira_lc_gate_wait_max_seconds[$__interval]))",
          "legendFormat": "{{verb}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "reads ended or held at the gate: what the caller did next",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 72,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (caller, outcome) (sum_over_time(spira_lc_read_followups[$__interval]))",
          "legendFormat": "{{outcome}} {{caller}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "control store file: bytes and free bytes",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 80,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "max_over_time(spira_state_store_file_bytes[$__interval])",
          "legendFormat": "file bytes",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "max_over_time(spira_state_store_free_bytes[$__interval])",
          "legendFormat": "free bytes",
          "refId": "B"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "control store free-page share",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 12,
        "y": 80,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "spira_state_store_free_bytes / spira_state_store_file_bytes",
          "legendFormat": "free share",
          "refId": "A"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "control store largest keyspaces",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 88,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "topk(3, max_over_time(spira_state_store_keyspace_bytes[$__interval]))",
          "legendFormat": "{{prefix}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "control store day-file bytes by family",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 12,
        "y": 88,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "max_over_time(spira_state_store_family_bytes[$__interval])",
          "legendFormat": "{{family}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "lc-serve child processes started",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 96,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum(sum_over_time(spira_lc_children_started[$__interval]))",
          "legendFormat": "all",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
