{
  "uid": "spira-runs",
  "title": "Spira runs: dwarves, claims and personas",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "tags": [
    "spira"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_VM",
        "type": "datasource",
        "query": "prometheus",
        "label": "data source"
      },
      {
        "name": "component",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_VM}"
        },
        "label": "component",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "query": {
          "query": "label_values(spira_component_runs, component)",
          "refId": "v"
        },
        "refresh": 2
      },
      {
        "name": "operation",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_VM}"
        },
        "label": "operation",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "query": {
          "query": "label_values(spira_component_runs, operation)",
          "refId": "v"
        },
        "refresh": 2
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "invocations by component / operation",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (component, operation) (increase(spira_component_runs{component=~\"$component\",operation=~\"$operation\"}[$__rate_interval]))",
          "legendFormat": "{{component}} {{operation}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "errors by component / error class",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (component, error_class) (increase(spira_component_runs{component=~\"$component\",operation=~\"$operation\",outcome=\"error\"}[$__rate_interval]))",
          "legendFormat": "{{component}} {{error_class}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "duration p50 / p90 by component",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, component) (rate(spira_component_run_seconds_bucket{component=~\"$component\",operation=~\"$operation\"}[$__rate_interval])))",
          "legendFormat": "p50 {{component}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "histogram_quantile(0.9, sum by (le, component) (rate(spira_component_run_seconds_bucket{component=~\"$component\",operation=~\"$operation\"}[$__rate_interval])))",
          "legendFormat": "p90 {{component}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "error rate by component",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (component) (increase(spira_component_runs{component=~\"$component\",operation=~\"$operation\",outcome=\"error\"}[$__rate_interval])) / sum by (component) (increase(spira_component_runs{component=~\"$component\",operation=~\"$operation\"}[$__rate_interval]))",
          "legendFormat": "{{component}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "calls by rune and result",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (rune, result) (increase(spira_component_events{component=~\"dwarf|sentinel\",kind=\"call\"}[$__rate_interval]))",
          "legendFormat": "{{rune}} {{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "model per attempt (first vs escalated)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (model, rework) (increase(spira_component_events{component=\"dwarf\",kind=\"attempt\"}[$__rate_interval]))",
          "legendFormat": "{{model}} {{rework}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "rework: escalations to the stronger model and holds",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (kind, rune) (increase(spira_component_events{component=\"dwarf\",kind=~\"escalated|held\"}[$__rate_interval]))",
          "legendFormat": "{{kind}} {{rune}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "czar detections by class and remedy",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (class, remedy) (increase(spira_component_events{component=\"czar-pass\",kind=\"detected\"}[$__rate_interval]))",
          "legendFormat": "{{class}} {{remedy}}",
          "refId": "A"
        }
      ]
    }
  ]
}
