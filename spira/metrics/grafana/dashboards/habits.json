{
  "uid": "spira-habits",
  "title": "Spira habit hooks",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "tags": [
    "spira"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_VM",
        "type": "datasource",
        "query": "prometheus",
        "label": "data source"
      },
      {
        "name": "repo",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_VM}"
        },
        "label": "repo",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "query": {
          "query": "label_values(habit_findings_total, repo)",
          "refId": "v"
        },
        "refresh": 2
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "findings handed to the builder, by habit",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (habit) (sum_over_time(habit_findings_total{repo=~\"$repo\"}[$__interval]))",
          "legendFormat": "{{habit}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "findings resolved by the next run, by habit",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (habit) (sum_over_time(habit_resolved_total{repo=~\"$repo\"}[$__interval]))",
          "legendFormat": "{{habit}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "habit run time p90, by habit",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "max by (habit) (quantile_over_time(0.9, habit_runtime_ms{repo=~\"$repo\"}[$__interval]))",
          "legendFormat": "{{habit}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "gate and round reds per landed bead",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum(sum_over_time(spira_cert_pass_verdicts{verdict=\"red\"}[$__interval])) / clamp_min(sum(increase(spira_landing_moved[$__interval])), 1)",
          "legendFormat": "reds per landed bead",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "unit-tests ignore rate: submitted after a red Stop, then red in a round",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "count((sum by (bead) (sum_over_time(habit_unit_tests_red_at_stop[$__range])) > 0) and on(bead) (sum by (bead) (sum_over_time(habit_unit_tests_red_in_round[$__range])) > 0)) / clamp_min(count(sum by (bead) (sum_over_time(habit_unit_tests_red_at_stop[$__range])) > 0), 1)",
          "legendFormat": "ignored",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "unit-tests Stop outcomes: beads red at Stop, fixed before submit, red in a round",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 16,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "count(sum by (bead) (sum_over_time(habit_unit_tests_red_at_stop[$__range])) > 0) or vector(0)",
          "legendFormat": "red at Stop",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "count(sum by (bead) (sum_over_time(habit_unit_tests_fixed_before_submit[$__range])) > 0) or vector(0)",
          "legendFormat": "fixed before submit",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "count((sum by (bead) (sum_over_time(habit_unit_tests_red_at_stop[$__range])) > 0) and on(bead) (sum by (bead) (sum_over_time(habit_unit_tests_red_in_round[$__range])) > 0)) or vector(0)",
          "legendFormat": "red at Stop, then red in a round",
          "refId": "C"
        }
      ]
    }
  ]
}
