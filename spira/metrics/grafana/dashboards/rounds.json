{
  "uid": "spira-rounds",
  "title": "Spira rounds",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "tags": [
    "spira"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_VM",
        "type": "datasource",
        "query": "prometheus",
        "label": "data source"
      },
      {
        "name": "repo",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_VM}"
        },
        "label": "repo",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "query": {
          "query": "label_values(spira_cert_pass_verdicts, repo)",
          "refId": "v"
        },
        "refresh": 2
      },
      {
        "name": "place",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_VM}"
        },
        "label": "place",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "query": {
          "query": "label_values(spira_cert_pass_verdicts, place)",
          "refId": "v"
        },
        "refresh": 2
      },
      {
        "name": "instance_type",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_VM}"
        },
        "label": "instance_type",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "query": {
          "query": "label_values(spira_cert_pass_verdicts, instance_type)",
          "refId": "v"
        },
        "refresh": 2
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "capacity_wait duration p50 / p90 by instance_type",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "quantile_over_time(0.9, spira_cert_pass_capacity_wait_seconds{repo=~\"$repo\",place=~\"$place\",instance_type=~\"$instance_type\"}[$__interval])",
          "legendFormat": "p90 {{instance_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "boot duration p50 / p90 by instance_type",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "quantile_over_time(0.9, spira_cert_pass_boot_seconds{repo=~\"$repo\",place=~\"$place\",instance_type=~\"$instance_type\"}[$__interval])",
          "legendFormat": "p90 {{instance_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "build duration p50 / p90 by instance_type",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "quantile_over_time(0.9, spira_cert_pass_build_seconds{repo=~\"$repo\",place=~\"$place\",instance_type=~\"$instance_type\"}[$__interval])",
          "legendFormat": "p90 {{instance_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "suites duration p50 / p90 by instance_type",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "quantile_over_time(0.9, spira_cert_pass_suites_seconds{repo=~\"$repo\",place=~\"$place\",instance_type=~\"$instance_type\"}[$__interval])",
          "legendFormat": "p90 {{instance_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "total pass duration p50 by repo",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "quantile_over_time(0.5, spira_cert_pass_total_seconds{repo=~\"$repo\",place=~\"$place\",instance_type=~\"$instance_type\"}[$__interval])",
          "legendFormat": "{{repo}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "total pass duration p90 by instance_type",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "quantile_over_time(0.9, spira_cert_pass_total_seconds{repo=~\"$repo\",place=~\"$place\",instance_type=~\"$instance_type\"}[$__interval])",
          "legendFormat": "{{instance_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "passes by verdict",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (verdict) (sum_over_time(spira_cert_pass_verdicts{repo=~\"$repo\",place=~\"$place\",instance_type=~\"$instance_type\"}[$__interval]))",
          "legendFormat": "{{verdict}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "passes by cause",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (cause) (sum_over_time(spira_cert_pass_causes{repo=~\"$repo\",place=~\"$place\",instance_type=~\"$instance_type\"}[$__interval]))",
          "legendFormat": "{{cause}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "infra-red rate",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum(sum_over_time(spira_cert_pass_causes{repo=~\"$repo\",place=~\"$place\",instance_type=~\"$instance_type\",cause=\"infra\"}[$__range])) / sum(sum_over_time(spira_cert_pass_causes{repo=~\"$repo\",place=~\"$place\",instance_type=~\"$instance_type\"}[$__range]))",
          "legendFormat": "infra share",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "red rate by repo",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (repo) (sum_over_time(spira_cert_pass_verdicts{repo=~\"$repo\",place=~\"$place\",instance_type=~\"$instance_type\",verdict=\"red\"}[$__range])) / sum by (repo) (sum_over_time(spira_cert_pass_verdicts{repo=~\"$repo\",place=~\"$place\",instance_type=~\"$instance_type\"}[$__range]))",
          "legendFormat": "{{repo}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "passes by place \u00d7 verdict",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (place, verdict) (sum_over_time(spira_cert_pass_verdicts{repo=~\"$repo\",place=~\"$place\",instance_type=~\"$instance_type\"}[$__interval]))",
          "legendFormat": "{{place}} {{verdict}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "pass wall time p90 by place",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "quantile_over_time(0.9, spira_cert_pass_total_seconds{repo=~\"$repo\",place=~\"$place\",instance_type=~\"$instance_type\"}[$__interval])",
          "legendFormat": "{{place}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "spill share (ec2 \u00f7 all)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum(sum_over_time(spira_cert_pass_verdicts{repo=~\"$repo\",place=~\"$place\",instance_type=~\"$instance_type\",place=\"ec2\"}[$__interval])) / sum(sum_over_time(spira_cert_pass_verdicts{repo=~\"$repo\",place=~\"$place\",instance_type=~\"$instance_type\"}[$__interval]))",
          "legendFormat": "spill share",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Coverage: workspace line coverage per round",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "spira_coverage_line_percent",
          "legendFormat": "lines %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Coverage: use cases covered / declared per area",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "spira_coverage_uc_covered{area!=\"all\"}",
          "legendFormat": "covered {{area}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "spira_coverage_uc_declared{area=\"all\"}",
          "legendFormat": "declared (all)",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "spira_coverage_uc_covered{area=\"all\"}",
          "legendFormat": "covered (all)",
          "refId": "C"
        }
      ]
    }
  ]
}
