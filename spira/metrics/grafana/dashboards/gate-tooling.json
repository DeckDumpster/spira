{
  "uid": "spira-gate-tooling",
  "title": "Spira gate and test tooling",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "tags": [
    "spira"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_VM",
        "type": "datasource",
        "query": "prometheus",
        "label": "data source"
      },
      {
        "name": "component",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_VM}"
        },
        "label": "component",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "query": {
          "query": "label_values(spira_component_invocations, component)",
          "refId": "v"
        },
        "refresh": 2
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "invocations by component and outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (component, outcome) (rate(spira_component_invocations{component=~\"$component\"}[$__rate_interval]))",
          "legendFormat": "{{component}} {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "run time p90 by component",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "histogram_quantile(0.9, sum by (le, component) (rate(spira_component_duration_seconds_bucket{component=~\"$component\"}[$__rate_interval])))",
          "legendFormat": "{{component}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "suites run (testenv)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum(rate(spira_testenv_suites_run[$__rate_interval]))",
          "legendFormat": "run",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum(rate(spira_testenv_suites_skipped[$__rate_interval]))",
          "legendFormat": "skipped",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "reds by class (testenv, gate-diag)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (class) (rate(spira_testenv_reds[$__rate_interval]))",
          "legendFormat": "testenv {{class}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (class) (rate(spira_gate_diag_reds[$__rate_interval]))",
          "legendFormat": "gate-diag {{class}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "slot queue wait p90 by pool",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "histogram_quantile(0.9, sum by (le, pool) (rate(spira_testenv_queue_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{pool}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "over-cap kills by tier",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (tier) (increase(spira_testenv_over_cap_kills[$__rate_interval]))",
          "legendFormat": "{{tier}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "gate-diag suites wall time",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "histogram_quantile(0.9, sum by (le) (rate(spira_gate_diag_suites_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p90",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "gate-worker verdicts filed",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum(rate(spira_gate_worker_verdicts[$__rate_interval]))",
          "legendFormat": "verdicts",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "yield meter: unit reds caught at submit, at the gate, and in a round, per day",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "interval": "1d",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum(sum_over_time(unit_red_at_submit[1d])) or vector(0)",
          "legendFormat": "red at submit (work checks)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum(sum_over_time(spira_gate_runs{status=\"FAIL\"}[1d])) or vector(0)",
          "legendFormat": "gate fails (every mode; no unit-only series exists)",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum(sum_over_time(habit_unit_tests_red_in_round[1d])) or vector(0)",
          "legendFormat": "red in a round",
          "refId": "C"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "unit-tests check seconds p50 and p90",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "quantile_over_time(0.5, check_seconds{check=\"unit-tests\"}[1d])",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "quantile_over_time(0.9, check_seconds{check=\"unit-tests\"}[1d])",
          "legendFormat": "p90",
          "refId": "B"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "build-directory pool: pool bytes against the budget, base bytes, evictions per day",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "evictions per day"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "last_over_time(build_dir_pool_bytes[1d])",
          "legendFormat": "pool (counted by the budget)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "last_over_time(build_dir_budget_bytes[1d])",
          "legendFormat": "budget",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "last_over_time(build_dir_base_bytes[1d])",
          "legendFormat": "base (everything under it)",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum(sum_over_time(build_dir_evicted[1d]))",
          "legendFormat": "evictions per day",
          "refId": "D"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "build-directory cleans: GB removed per day by branch and cause",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (branch, cause) (sum_over_time(build_dir_clean_bytes[1d])) / 1e9",
          "legendFormat": "{{branch}} {{cause}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (mode) (sum_over_time(build_dir_clean_bytes[1d])) / 1e9",
          "legendFormat": "all {{mode}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "fences-mode covered phase: median and p90 seconds it added, suites deferred to the round",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "suites deferred (sum)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "quantile_over_time(0.5, spira_gate_covered_seconds{gate_mode=\"fences\"}[$__interval])",
          "legendFormat": "median seconds",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "quantile_over_time(0.9, spira_gate_covered_seconds{gate_mode=\"fences\"}[$__interval])",
          "legendFormat": "p90 seconds",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum(sum_over_time(spira_gate_covered_deferred{gate_mode=\"fences\"}[$__interval]))",
          "legendFormat": "suites deferred (sum)",
          "refId": "C"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Gate test reruns by result (1d)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "interval": "1d",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (result) (sum_over_time(spira_gate_test_reruns[1d]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "build folders: leases per day by repository and state",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 72,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (repo, state) (sum_over_time(build_dir_lease[1d]))",
          "legendFormat": "{{repo}} {{state}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "build folders: wipes per day by repository and cause",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 12,
        "y": 72,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "sum by (repo, cause) (sum_over_time(build_dir_lease{state=\"wiped\"}[1d]))",
          "legendFormat": "{{repo}} {{cause}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "build folders: median first-build seconds by repository",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "gridPos": {
        "x": 0,
        "y": 80,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "expr": "max by (repo) (quantile_over_time(0.5, build_dir_first_build_seconds[1d]))",
          "legendFormat": "{{repo}}",
          "refId": "A"
        }
      ]
    }
  ]
}
