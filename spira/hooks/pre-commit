#!/usr/bin/env bash
#
# pre-commit — three fences, in order:
#
#   1. exclude.sh staged        — refuses beads data in staged files
#   2. spira-lint, the cheap deterministic rules — scratch-fence, tmp-leak, chmod-exec-leak,
#      env-set-var-leak, fence-scripts, config-fence: the refusal surfaces in the session
#      that wrote the defect, not at certification
#   3. branch-guard.sh staged   — refuses aeon-identity commits on the base branch
#
# Armed by `exclude.sh install`, which sets core.hooksPath to this directory. That is why
# the hook is TRACKED rather than copied into .git/hooks: .git/hooks is not cloned, so a
# colleague would get the harness with its fences quietly missing. Tracked, it travels; one
# `git config` line arms it.
#
# All the judgement is in exclude.sh, spira-lint's scratch-fence rule and branch-guard.sh,
# so there is one implementation of each rule and each test suite exercises the thing that
# actually runs. Resolved relative to this file, so it works in a worktree and in a clone at
# any path.
#
# scratch-fence moved to spira-lint (sp-ekkak). Every tool here — exclude.sh, spira-lint,
# branch-guard.sh — is invoked by bare name on the PATH the launcher set (sp-gypjk): the
# worktree creator points core.hooksPath at the release's spira/hooks and the aeon's
# environment carries the release PATH, so the hook and the tools it runs are the
# release's. A tool missing from PATH refuses the commit, naming it; it never silently
# skips the check.
set -uo pipefail
# THE TOOLS BESIDE THIS HOOK FIRST (sp-tf7nt). core.hooksPath points at a release's
# spira/hooks, so <release>/spira and <release>/bin are this hook's own release. Under
# an aeon the model's PATH is restricted (aeon/src/restrict.rs: /usr/bin, /bin,
# the release's bin/) and omits spira/, so a bare-name lookup alone refused every commit on
# a fresh install; production only passed because the agent's shell inherited a profile
# PATH. Still the release's tools, still refusing when one is missing.
_hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
for _d in "$_hook_dir/../../bin" "$_hook_dir/.."; do
    [ -d "$_d" ] && PATH="$(cd "$_d" && pwd -P):$PATH"
done
export PATH
unset _hook_dir _d
for _t in exclude.sh spira-lint branch-guard.sh; do
    command -v "$_t" >/dev/null 2>&1 || {
        echo "pre-commit: $_t is not on PATH — the launcher sets PATH to a release; refusing to commit unchecked" >&2
        exit 1
    }
done
exclude.sh staged || exit 1
spira-lint --only scratch-fence || exit 1
# The other rules judge the harness's own sources; in a repository carrying none they would
# refuse an empty scope and mask every later fence.
if exclude.sh harness >/dev/null 2>&1; then
    for _r in tmp-leak chmod-exec-leak env-set-var-leak fence-scripts config-fence; do
        spira-lint --only "$_r" || exit 1
    done
fi
exec branch-guard.sh staged
