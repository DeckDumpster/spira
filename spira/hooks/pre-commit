#!/usr/bin/env bash
#
# pre-commit — three fences, in order:
#
#   1. exclude.sh staged        — refuses beads data in staged files
#   2. spira-lint scratch-fence — refuses aeon scratch files at the harness root
#   3. branch-guard.sh staged   — refuses aeon-identity commits on the base branch
#
# Armed by `exclude.sh install`, which sets core.hooksPath to this directory. That is why
# the hook is TRACKED rather than copied into .git/hooks: .git/hooks is not cloned, so a
# colleague would get the harness with its fences quietly missing. Tracked, it travels; one
# `git config` line arms it.
#
# All the judgement is in exclude.sh, spira-lint's scratch-fence rule and branch-guard.sh,
# so there is one implementation of each rule and each test suite exercises the thing that
# actually runs. Resolved relative to this file, so it works in a worktree and in a clone at
# any path.
#
# scratch-fence moved to spira-lint (sp-ekkak): this hook resolves SPIRA_LINT_BIN the same
# way gate-spira.sh does (a subshell over conf.sh, so sourcing it does not touch this
# script's own environment) and fails closed — refuses the commit — when the binary is not
# built, rather than silently skip the check.
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
bash "$HERE/../exclude.sh" staged || exit 1
: "${SPIRA_LINT_BIN:=$( . "$HERE/../conf.sh" >/dev/null 2>&1; printf '%s' "${SPIRA_LINT_BIN:-}")}"
[ -x "${SPIRA_LINT_BIN:-}" ] || { echo "pre-commit: spira-lint is not built (SPIRA_LINT_BIN) — refusing to commit unchecked" >&2; exit 1; }
"$SPIRA_LINT_BIN" --only scratch-fence || exit 1
exec bash "$HERE/../branch-guard.sh" staged
