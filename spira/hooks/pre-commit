#!/usr/bin/env bash
#
# pre-commit — three fences, in order:
#
#   1. exclude.sh staged        — refuses beads data in staged files
#   2. spira-lint scratch-fence — refuses aeon scratch files at the harness root
#   3. branch-guard.sh staged   — refuses aeon-identity commits on the base branch
#
# Armed by `exclude.sh install`, which sets core.hooksPath to this directory. That is why
# the hook is TRACKED rather than copied into .git/hooks: .git/hooks is not cloned, so a
# colleague would get the harness with its fences quietly missing. Tracked, it travels; one
# `git config` line arms it.
#
# All the judgement is in exclude.sh, spira-lint's scratch-fence rule and branch-guard.sh,
# so there is one implementation of each rule and each test suite exercises the thing that
# actually runs. Resolved relative to this file, so it works in a worktree and in a clone at
# any path.
#
# scratch-fence moved to spira-lint (sp-ekkak). Resolved the way the rest of the harness
# resolves a Rust tool, in order, because an aeon worktree neither sets SPIRA_LINT_BIN nor
# installs a release: an already-set SPIRA_LINT_BIN; else conf.sh's spira_bin (the
# installed release, e.g. /home/ryan/spira/harness/bin/spira-lint); else this worktree's
# own build, aeon profile before release (aeon worktrees build crates for their own unit
# tests and rarely carry an installed release). Fails closed — refuses the commit, naming
# what to build — only when none of those resolves to an executable; it never silently
# skips the check.
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
bash "$HERE/../exclude.sh" staged || exit 1
ROOT="$(cd "$HERE/../.." && pwd)"
[ -x "${SPIRA_LINT_BIN:-}" ] || SPIRA_LINT_BIN="$( . "$HERE/../conf.sh" >/dev/null 2>&1; printf '%s' "${SPIRA_LINT_BIN:-}")"
if [ ! -x "${SPIRA_LINT_BIN:-}" ]; then
    for _cand in "$ROOT/target/aeon/spira-lint" "$ROOT/target/release/spira-lint"; do
        [ -x "$_cand" ] && { SPIRA_LINT_BIN="$_cand"; break; }
    done
fi
[ -x "${SPIRA_LINT_BIN:-}" ] || {
    echo "pre-commit: spira-lint is not built — build it (cargo build -p spira-lint), install a release, or set SPIRA_LINT_BIN — refusing to commit unchecked" >&2
    exit 1
}
"$SPIRA_LINT_BIN" --only scratch-fence || exit 1
exec bash "$HERE/../branch-guard.sh" staged
