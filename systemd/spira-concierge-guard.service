[Unit]
Description=Spira concierge guard — write an inbox row when the Concierge inbox waiter lapses, mail the operator when the lapse persists
After=default.target

[Service]
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=SPIRA_TOML=@SPIRA_TOML@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:@SPIRA_ENV_PATH@:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
Type=oneshot
CPUQuota=10%
ExecStart=@SPIRA_PROD_ROOT@/bin/concierge-guard check --state @SPIRA_RUN@/concierge-guard.state --session concierge --waiter inbox-next --waiter "watchd next concierge-inbox" --inbox-text "CONCIERGE GUARD (timer, not the operator): no inbox waiter is running under this session. Run watchd next concierge-inbox with Bash run_in_background NOW, then read the recent lines of the Concierge inbox and your mailbox and act on what you missed." --mail-after 600 --mail mail --from "Concierge guard <concierge-guard@spira>"
TimeoutStartSec=60
StandardOutput=append:@SPIRA_RUN@/concierge-guard.log
StandardError=append:@SPIRA_RUN@/concierge-guard.log

[Install]
WantedBy=default.target

[X-Spira]
Plane=observability
