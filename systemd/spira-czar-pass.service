[Unit]
Description=Spira czar fast pass — queue-stall detection with deterministic remedies
Documentation=file://@SPIRA_HOME@/czar.sh
After=default.target

[Service]
# THE LAUNCHER'S PATH, SET OUTRIGHT (sp-31gtu): the release this unit runs, and PATH built
# from it alone — nothing inherited from the user manager — so every tool invoked by bare
# name is that release's. Rendered from the release root (spira-releases/<sha>; the harness
# checkout's root until the release deploy lands).
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:/usr/local/bin:/usr/bin:/bin
Type=oneshot
ExecStart=@SPIRA_PROD@/czar.sh --pass
# A pass reads local files and makes at most 2 gh API calls; 60 s is generous.
TimeoutStartSec=60
Environment=SPIRA_HOME=@SPIRA_PROD@
Environment=SPIRA_RUN=@SPIRA_RUN@
StandardOutput=append:@SPIRA_RUN@/czar.log
StandardError=append:@SPIRA_RUN@/czar.log

[Install]
WantedBy=default.target
