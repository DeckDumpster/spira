[Unit]
Description=File a groomer trigger bead every six hours

[Timer]
# SIX HOURS. The groomer's job is coalescing: splitting unsplittable beads, merging
# duplicates, closing stale premises, correcting mislabelled lanes. The bead graph
# grows at most a few dozen entries per day; sweeping more often re-examines the same
# beads and spends model capacity on confirmation rather than discovery. Six hours
# matches the QA cadence, which faces the same growth rate from a different angle.
#
# THIS FILE IS THE ONLY PLACE THE CADENCE IS WRITTEN. groomer.fayth's comment
# references it; nothing reads a SPIRA_GROOM_EVERY key, because none exists.
OnBootSec=15min
OnActiveSec=15min
OnUnitActiveSec=6h
AccuracySec=5min
Unit=spira-groom.service

[Install]
WantedBy=timers.target

[X-Spira]
Plane=work
