[Unit]
Description=Archive session transcripts every twenty minutes

[Timer]
# TWENTY MINUTES IS THE WINDOW OF LOSS, and nothing else. A pass that finds nothing changed
# writes nothing at all, so the cadence costs only the stat of each transcript — what it buys
# is how much of a live conversation is missing if the volume holding the client's own copy
# goes away between passes. The session-end hook covers the ordinary case; this covers the
# session that never ends cleanly.
OnBootSec=5min
OnActiveSec=5min
OnUnitActiveSec=20min
AccuracySec=1min
Persistent=true
Unit=spira-archive.service

[Install]
WantedBy=timers.target
