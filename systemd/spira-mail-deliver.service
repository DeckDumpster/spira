[Unit]
Description=Spira mail delivery daemon — wake registered readers on new mail
Documentation=file://@SPIRA_HOME@/spira-mail-deliver.sh
After=default.target
# Restart bounds: five restarts over 120s before giving up.  inotifywait exits
# immediately if the watch path is missing; the daemon recreates it before
# exec so ordinary restarts do not count toward the limit.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
# THE LAUNCHER'S PATH, SET OUTRIGHT (sp-31gtu): the release this unit runs, and PATH built
# from it alone — nothing inherited from the user manager — so every tool invoked by bare
# name is that release's. Rendered from the release root (spira-releases/<sha>; the harness
# checkout's root until the release deploy lands).
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=SPIRA_TOML=@SPIRA_TOML@
Environment=SPIRA_LC_PASSWORD_FILE=@SPIRA_LC_PASSWORD_FILE@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
Type=simple
ExecStart=@SPIRA_PROD@/spira-mail-deliver.sh
Restart=always
RestartSec=15
# A halt's SIGTERM exits 143; without this the unit lands 'failed', not 'inactive'.
SuccessExitStatus=143
# Same path watchd.sh's own _wd_logfile computes for an `extern` row: @SPIRA_RUN@/watchd/%name%.log.
StandardOutput=append:@SPIRA_RUN@/watchd/mail-deliver.log
StandardError=append:@SPIRA_RUN@/watchd/mail-deliver.log

[Install]
WantedBy=default.target

[X-Spira]
Plane=work
