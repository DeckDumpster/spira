[Unit]
# Pushes Spira's beads database to its configured Dolt remote. make-beads-repo.sh wired
# real private GitHub remotes and then nothing ever pushed again — three databases last
# received data on 2026-09-02 within 36 seconds of each other, the signature of a one-shot
# setup script rather than a backup. A configured remote that nothing pushes answers "is
# this backed up?" with a yes it has not earned.
Description=Push Spira's beads Dolt database to its configured remote
Documentation=file://@SPIRA_PROD_ROOT@/beads-push.sh
After=default.target

[Service]
# THE LAUNCHER'S PATH, SET OUTRIGHT (sp-31gtu): the release this unit runs, and PATH built
# from it alone — nothing inherited from the user manager — so every tool invoked by bare
# name is that release's. Rendered from the release root (spira-releases/<sha>; the harness
# checkout's root until the release deploy lands).
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=SPIRA_TOML=@SPIRA_TOML@
Environment=SPIRA_LC_PASSWORD_FILE=@SPIRA_LC_PASSWORD_FILE@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
Type=oneshot
ExecStart=@SPIRA_PROD_ROOT@/beads-push.sh
TimeoutStartSec=1800
IOSchedulingClass=idle
Nice=19
CPUQuota=50%
StandardOutput=append:@SPIRA_RUN@/beads-push.log
StandardError=append:@SPIRA_RUN@/beads-push.log

[Install]
WantedBy=default.target
