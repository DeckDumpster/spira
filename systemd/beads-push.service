[Unit]
# Pushes Spira's beads database to its configured Dolt remote. make-beads-repo.sh wired
# real private GitHub remotes and then nothing ever pushed again — three databases last
# received data on 2026-09-02 within 36 seconds of each other, the signature of a one-shot
# setup script rather than a backup. A configured remote that nothing pushes answers "is
# this backed up?" with a yes it has not earned.
Description=Push Spira's beads Dolt database to its configured remote
Documentation=file://@SPIRA_REPO@/beads-push.sh
After=default.target

[Service]
Type=oneshot
ExecStart=@SPIRA_REPO@/beads-push.sh
TimeoutStartSec=3600
# This box also runs prod and the CI runner; a Dolt push is bursty and must never be the
# reason something user-facing gets slow (law-fence-loops-on-shared-hardware).
CPUQuota=50%
Nice=10
IOSchedulingClass=idle
StandardOutput=append:@SPIRA_RUN@/beads-push.log
StandardError=append:@SPIRA_RUN@/beads-push.log

[Install]
WantedBy=default.target
