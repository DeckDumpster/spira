[Unit]
# ONE TEMPLATE FOR EVERY WATCHER. The instance name is the watcher's name in the manifest,
# and nothing else about a watcher appears here — not its command, not its log — so adding
# one is a manifest row plus an install run rather than another unit file to keep in step.
#
# Watchers used to be created inside a coding-agent session, which owns them: they were made
# by hand, nothing outside the transcript knew they should exist, and clearing the session
# killed them. The point of this unit is that the outer harness owns the process and a
# session merely latches onto its log.
Description=Spira watcher %i
Documentation=file://@SPIRA_HOME@/watchd.sh
After=default.target
# THE BURST LIMITER HAS TO BE REACHABLE. Five starts at RestartSec=15 span at least 60s, so
# systemd's default 10s window can never hold five and the limiter never fires — a target
# that exits on every start loops forever instead of landing in failed. Keep this above
# RestartSec * (StartLimitBurst - 1); test-watch-unit-restart.sh asserts the relationship,
# not the numbers. These belong in [Unit]: systemd ignores them under [Service].
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
# THE LAUNCHER'S PATH, SET OUTRIGHT (sp-31gtu): the release this unit runs, and PATH built
# from it alone — nothing inherited from the user manager — so every tool invoked by bare
# name is that release's. Rendered from the release root (spira-releases/<sha>; the harness
# checkout's root until the release deploy lands).
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
Type=simple
# THE DISPATCHER, NOT THE COMMAND. `watchd.sh exec %i` resolves the row's target through the
# manifest, so the manifest stays the single source of truth and no path is baked into a unit
# — a unit with a path in it runs on exactly one box, and systemd's complaint about a wrong
# one is a bare "No such file or directory" in a journal nobody is watching.
ExecStart=@SPIRA_PROD@/watchd.sh exec %i
Restart=always
RestartSec=15
# THE HINGE. The unit appends stdout to exactly the log the cursor indexes, which is how
# systemd can own the process without changing the contract a reader latches onto: two files,
# a log and an integer, and `tail -n +N -F` is a conforming client.
#
# systemd opens this file BEFORE ExecStart, so the directory must already exist — install.sh
# creates it, and a unit started against a missing one fails instantly with a message about
# the file rather than about the watcher.
StandardOutput=append:@SPIRA_RUN@/watchd/%i.log
StandardError=append:@SPIRA_RUN@/watchd/%i.log

[Install]
WantedBy=default.target
