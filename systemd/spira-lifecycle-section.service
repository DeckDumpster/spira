[Unit]
After=lc-serve.service
Wants=lc-serve.service
Description=Spira lifecycle section — goodput from loop events, published on change

[Service]
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=SPIRA_TOML=@SPIRA_TOML@
Environment=SPIRA_LC_PASSWORD_FILE=@SPIRA_LC_PASSWORD_FILE@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:@SPIRA_ENV_PATH@:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
Type=oneshot
ExecStart=@SPIRA_PROD_ROOT@/bin/spira-lc publish-section lifecycle
TimeoutStartSec=50
StandardOutput=append:@SPIRA_RUN@/lifecycle-section.log
StandardError=append:@SPIRA_RUN@/lifecycle-section.log

[Install]
WantedBy=default.target

[X-Spira]
Plane=observability
