[Unit]
Description=Spira mend-watch — a mender past its deadline, or a bead mended more than twice in a day
After=lc-serve.service
Wants=lc-serve.service

[Service]
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=SPIRA_TOML=@SPIRA_TOML@
Environment=SPIRA_LC_PASSWORD_FILE=@SPIRA_LC_PASSWORD_FILE@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:@SPIRA_ENV_PATH@:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
Type=oneshot
ExecStart=@SPIRA_PROD_ROOT@/bin/spira-lc mend-watch --seen @SPIRA_RUN@/mend-watch.seen
TimeoutStartSec=60
StandardOutput=append:@SPIRA_RUN@/mend-watch.log
StandardError=append:@SPIRA_RUN@/mend-watch.log

[Install]
WantedBy=default.target

[X-Spira]
Plane=observability
