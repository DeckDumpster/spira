[Unit]
Description=Evaluate gh:run CI gates every two minutes

[Timer]
# TWO MINUTES IS THE SENTINEL CADENCE, and the CI check used to run inside the sentinel
# at that cadence. Keeping them aligned means a bead whose gate resolves on one tick of
# the sentinel is visible to the next tick, which is the behaviour the old label sweep had.
#
# The check is cheap (one gh call per open gate), so two minutes is not wasteful — and
# a gate that sits unresolved for two minutes while CI has already finished is a bead
# that stays invisible for that window, which is the cost of a coarser cadence.
OnBootSec=90
OnActiveSec=90
OnUnitActiveSec=2min
AccuracySec=30s
Unit=spira-gate-check.service

[Install]
WantedBy=timers.target
