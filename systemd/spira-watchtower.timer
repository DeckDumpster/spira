[Unit]
Description=Wake Ops on a timer and hand it the pipeline's vital signs

[Timer]
# THIRTY MINUTES, AND ops.fayth's FAYTH_TIMEOUT_SECONDS IS SET UNDER IT. The two numbers are
# a pair: a sweep arriving faster than Ops can finish one queues snapshots behind a session
# already working a stale picture, and the first live sweep ran eighteen minutes against a
# ten-minute cadence. Whoever shortens this must check that wall first.
#
# THIS FILE IS THE ONLY PLACE THE CADENCE IS WRITTEN. ops.fayth's comment names it; nothing
# reads a SPIRA_WATCH_EVERY key, because none exists.
#
# WIDENED FROM TEN because the sweep wakes Ops whether or not anything is wrong, and one
# no-op pass measured 1.8M cache-read tokens and $2.23 to conclude the pipeline was fine
# (per the operator, 2026-09-07). Detection is still the point — a stall now surfaces in
# half an hour rather than the fifty minutes it took before any of this existed — but the
# instrument must not cost more than what it instruments.
OnBootSec=3min
OnActiveSec=3min
OnUnitActiveSec=30min
AccuracySec=30s
Unit=spira-watchtower.service

[Install]
WantedBy=timers.target

[X-Spira]
Plane=observability
