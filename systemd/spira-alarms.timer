[Unit]
Description=Run the alarms pass every minute

[Timer]
# The dead-man check rides this timer: it must keep running when the work plane is halted.
OnBootSec=90s
OnActiveSec=90s
OnUnitActiveSec=60s
AccuracySec=10s
Unit=spira-alarms.service

[Install]
WantedBy=timers.target

[X-Spira]
Plane=observability
