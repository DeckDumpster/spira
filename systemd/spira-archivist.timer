[Unit]
Description=Sweep the live sessions for unfinished business when enough turns have passed

[Timer]
# FIVE MINUTES, not two. What this watches moves in tens of minutes: a session accumulates
# turns over many of them, and the archivist's answer stays true for as long as the session
# is idle. The sentinel is fast because a lease dies in minutes; nothing here does.
#
# It is also not free. A drift that exceeds the threshold summons a model session, so the
# cadence is the ceiling on how often that can happen.
OnBootSec=5min
OnActiveSec=5min
OnUnitActiveSec=5min
AccuracySec=1min
# NOT Persistent. A missed tick is a session that filled up while the box was off, and there
# is nobody at that keyboard now — catching up on boot would archive a transcript whose
# session has already ended, which is work nobody is waiting on and a model session spent.
Unit=spira-archivist.service

[Install]
WantedBy=timers.target

[X-Spira]
Plane=maintenance
