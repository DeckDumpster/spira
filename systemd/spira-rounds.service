[Unit]
Description=Spira rounds — cut, certify and land a round for every queue-mode repo on the harness's own round path
Documentation=file://@SPIRA_PROD_ROOT@/batcher-cut/DESIGN.md
After=default.target

[Service]
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=SPIRA_TOML=@SPIRA_TOML@
Environment=SPIRA_LC_PASSWORD_FILE=@SPIRA_LC_PASSWORD_FILE@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
Environment=SPIRA_HOME=@SPIRA_HOME@
Environment=SPIRA_RUN=@SPIRA_RUN@
Environment=SPIRA_DB=@SPIRA_DB@
Type=oneshot
ExecStart=@SPIRA_PROD_ROOT@/bin/batcher rounds
TimeoutStartSec=7200
CPUQuota=50%
StandardOutput=append:@SPIRA_RUN@/rounds.log
StandardError=append:@SPIRA_RUN@/rounds.log

[X-Spira]
Plane=work
