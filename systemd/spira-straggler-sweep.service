[Unit]
After=lc-serve.service
Wants=lc-serve.service
# The only scheduled caller of the branch sweep, and it covers every repository: nothing
# else sweeps queue.local or push repos, and queue.forge repos need it for what the
# landing-time reap missed.
Description=Spira straggler sweep — reap branches of finished beads in every repository
Documentation=file://@SPIRA_PROD_ROOT@/sending/DESIGN.md
After=default.target

[Service]
# THE LAUNCHER'S PATH, SET OUTRIGHT (sp-31gtu): the release this unit runs, and PATH built
# from it alone — nothing inherited from the user manager — so every tool invoked by bare
# name is that release's. Rendered from the release root (spira-releases/<sha>; the harness
# checkout's root until the release deploy lands).
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=SPIRA_TOML=@SPIRA_TOML@
Environment=SPIRA_LC_PASSWORD_FILE=@SPIRA_LC_PASSWORD_FILE@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:@SPIRA_ENV_PATH@:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
Type=oneshot
ExecStart=@SPIRA_PROD_ROOT@/bin/sending --budget-secs 900
TimeoutStartSec=1200
StandardOutput=append:@SPIRA_RUN@/straggler-sweep.log
StandardError=append:@SPIRA_RUN@/straggler-sweep.log

[Install]
WantedBy=default.target

[X-Spira]
Plane=work
