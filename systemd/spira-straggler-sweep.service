[Unit]
# Queue-mode repos are not swept by the per-pass sentinel Sending (spira-sentinel's
# --skip-queue call) — their landed branches are reaped at landing itself. This is the
# once-a-day backstop for whatever that landing-time reap missed.
Description=Spira straggler sweep — reap stranded branches/worktrees in queue-mode repos
Documentation=file://@SPIRA_PROD_ROOT@/sending/DESIGN.md
After=default.target

[Service]
# THE LAUNCHER'S PATH, SET OUTRIGHT (sp-31gtu): the release this unit runs, and PATH built
# from it alone — nothing inherited from the user manager — so every tool invoked by bare
# name is that release's. Rendered from the release root (spira-releases/<sha>; the harness
# checkout's root until the release deploy lands).
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=SPIRA_LC_PASSWORD_FILE=@SPIRA_LC_PASSWORD_FILE@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
Type=oneshot
ExecStart=@SPIRA_PROD_ROOT@/bin/sending --queue-only
TimeoutStartSec=600
StandardOutput=append:@SPIRA_RUN@/straggler-sweep.log
StandardError=append:@SPIRA_RUN@/straggler-sweep.log

[Install]
WantedBy=default.target

[X-Spira]
Plane=work
