[Unit]
# Queue-mode repos are not swept by the per-pass sentinel Sending (spira-sentinel's
# --skip-queue call) — their landed branches are reaped at landing itself. This is the
# once-a-day backstop for whatever that landing-time reap missed.
Description=Spira straggler sweep — reap stranded branches/worktrees in queue-mode repos
Documentation=file://@SPIRA_HOME@/sending.sh
After=default.target

[Service]
Type=oneshot
ExecStart=@SPIRA_PROD@/sending.sh --queue-only
TimeoutStartSec=600
StandardOutput=append:@SPIRA_RUN@/straggler-sweep.log
StandardError=append:@SPIRA_RUN@/straggler-sweep.log

[Install]
WantedBy=default.target
