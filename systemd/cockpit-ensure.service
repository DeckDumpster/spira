[Unit]
# Self-heal for the cockpit. Was documented as depending on a session-scoped watcher,
# which is precisely what dies when a session is interrupted — on 2026-09-01 the health
# pane exited and nothing brought it back, while every liveness check stayed green.
# A repair loop that only runs while a session is alive cannot repair the case where the
# session died.
Description=Repair the cockpit tmux layout and the session hook's registration
Documentation=file://@SPIRA_PROD_ROOT@/cockpit/ops/DESIGN.md
After=default.target

[Service]
# THE LAUNCHER'S PATH, SET OUTRIGHT (sp-31gtu): the release this unit runs, and PATH built
# from it alone — nothing inherited from the user manager — so every tool invoked by bare
# name is that release's. Rendered from the release root (spira-releases/<sha>; the harness
# checkout's root until the release deploy lands).
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
Type=oneshot
# The session hook's registration lives in the coding agent client's own settings file, which
# is outside every checkout — so no landing gate can see it and nothing that lands can fix it.
# Repaired here, from systemd, for the same reason the panes are: a registration done once by
# hand rots invisibly, and the failure it rots into is a hook still bound to a decommissioned
# harness's path, printing that harness's banner into every session on the box.
#
# It is idempotent and writes nothing when the file already says what it should, and it
# REFUSES while the hook's own file is absent — so between arming this and the branch that
# adds the hook landing, the pass is a no-op rather than a registration pointing at nothing.
ExecStartPre=-@SPIRA_PROD@/install-session-hook.sh install
ExecStart=@SPIRA_PROD_ROOT@/bin/layout ensure
TimeoutStartSec=60
StandardOutput=append:@SPIRA_RUN@/cockpit-heal.log
StandardError=append:@SPIRA_RUN@/cockpit-heal.log

[Install]
WantedBy=default.target
