[Unit]
After=lc-serve.service
Wants=lc-serve.service
# Self-heal for the cockpit, started by the scheduler's `cockpit.ensure` task when one of the
# cockpit's inputs moved. It is not session-scoped: a repair that only runs while a session
# is alive cannot repair the case where the session died.
Description=Repair the cockpit tmux layout
Documentation=file://@SPIRA_PROD_ROOT@/cockpit/ops/DESIGN.md

[Service]
# THE LAUNCHER'S PATH, SET OUTRIGHT (sp-31gtu): the release this unit runs, and PATH built
# from it alone — nothing inherited from the user manager — so every tool invoked by bare
# name is that release's. Rendered from the release root (spira-releases/<sha>; the harness
# checkout's root until the release deploy lands).
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=SPIRA_TOML=@SPIRA_TOML@
Environment=SPIRA_LC_PASSWORD_FILE=@SPIRA_LC_PASSWORD_FILE@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:@SPIRA_ENV_PATH@:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
Type=oneshot
# The session hook is registered at install/activation (`release session-hook install`), not
# here: a pass starts no process it does not need.
ExecStart=@SPIRA_PROD_ROOT@/bin/layout ensure
TimeoutStartSec=60
StandardOutput=append:@SPIRA_RUN@/cockpit-heal.log
StandardError=append:@SPIRA_RUN@/cockpit-heal.log

[Install]
WantedBy=default.target
