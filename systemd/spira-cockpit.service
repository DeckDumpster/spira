[Unit]
# Spira's own collector. It used to be driven from inside the Gas Town collector, which
# called `spira/cockpit.sh once` at the end of its own pass — a dependency that would have
# silently frozen this dashboard the moment the purge deleted that file. A pane that stops
# updating still renders, and a stale panel is the failure mode this whole surface exists
# to prevent.
Description=Spira cockpit collector (snapshot for the ops pane)
Documentation=file://@SPIRA_HOME@/collect.sh
After=default.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStart=@SPIRA_PROD@/collect.sh loop
Restart=always
RestartSec=15
# WatchdogSec is absent: bash cannot satisfy it — only the main PID's own datagram is credited,
# and an unprivileged process cannot assert another PID in SCM_CREDENTIALS, so --pid= is ignored.
# Liveness is the snapshot's age instead (sp-3az9w; sp-mplcb restores this with a Rust supervisor).
# A pass shells out to bd and git several times. This box also runs prod, so it is fenced
# (law-fence-loops-on-shared-hardware).
CPUQuota=35%
Nice=10
StandardOutput=append:@SPIRA_RUN@/collector.log
StandardError=append:@SPIRA_RUN@/collector.log

[Install]
WantedBy=default.target
