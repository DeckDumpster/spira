[Unit]
After=lc-serve.service
Wants=lc-serve.service
Description=Spira incident settle — close incidents whose fix landed and whose detector is quiet
Documentation=file://@SPIRA_PROD_ROOT@/incident/DESIGN.md

[Service]
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=SPIRA_TOML=@SPIRA_TOML@
Environment=SPIRA_LC_PASSWORD_FILE=@SPIRA_LC_PASSWORD_FILE@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:@SPIRA_ENV_PATH@:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
Type=oneshot
ExecCondition=/usr/bin/test -x @SPIRA_PROD_ROOT@/bin/incident
ExecStart=@SPIRA_PROD_ROOT@/bin/incident settle
TimeoutStartSec=300
StandardOutput=append:@SPIRA_RUN@/incident.log
StandardError=append:@SPIRA_RUN@/incident.log

[Install]
WantedBy=default.target

[X-Spira]
Plane=maintenance
