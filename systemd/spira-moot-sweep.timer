[Unit]
Description=Resolve moot asks every fifteen minutes

[Timer]
# FIFTEEN MINUTES. Auto-filed alerts can clear before the operator sees the ask; a
# fifteen-minute window means a cleared condition rarely sits in the queue for a full
# session. Janitorial — latency does not matter here, only that it runs.
OnBootSec=5min
OnActiveSec=5min
OnUnitActiveSec=15min
AccuracySec=2min
Persistent=true
Unit=spira-moot-sweep.service

[Install]
WantedBy=timers.target

[X-Spira]
Plane=maintenance
