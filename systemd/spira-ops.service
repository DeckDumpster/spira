[Unit]
# The Ops persona's TIMER trigger. The timer path runs a beadless sweep: Ops reads the
# watchtower snapshot, runs the scans on its menu, and files beads for anything that needs
# attention. Incident claims arrive from the sentinel, which summons Ops directly when an
# incident bead is ready — that path does not run through this service file.
#
# The two ExecStartPre lines below (drain the spool, repair the wiring) belong to the
# incident arrival path and have nothing to do with the sweep: they are kept here because
# this service is the one thing that runs on every timer tick whether or not there are
# incidents, making it the cheapest place to do idempotent intake maintenance.
Description=Spira Ops — sweep the pipeline on a cadence; incidents arrive via the sentinel
Documentation=file://@SPIRA_HOME@/chamber/ops.fayth
After=default.target

[Service]
Type=oneshot
# Inert until the persona exists on main. This unit is installed and enabled by the same
# change that ADDS ops.fayth, so between arming the timer and the branch landing there is a
# window in which ExecStart would fail every five minutes — and a unit that is red for
# reasons nobody should act on is the noise that hides the one that matters. An
# ExecCondition that exits non-zero makes systemd SKIP the pass and record success, so the
# timer sits silent and starts working by itself the moment the file is there. No step for
# anyone to remember.
ExecCondition=/usr/bin/test -f @SPIRA_PROD@/chamber/ops.fayth
# SKIP WHEN NOMINAL. watchtower.sh writes SWEEP:NOMINAL as the first line of the prompt
# file when every measurable signal is green: no lapses, fresh snapshot, no stuck
# no-verdict branches, no drain. A model session reading a nominal snapshot costs ~22k
# tokens to say hello — the expensive way to run an if. When the first line is that
# marker, this ExecCondition exits 1 (skipped, not failed) after logging the reason,
# and the ExecStart below never runs. The file must exist (the preceding ExecCondition
# guarantees it ran at least once) so the absence case remains a genuine error.
ExecCondition=/bin/bash -c 'f=@SPIRA_RUN@/ops-sweep-prompt.txt; l=$(head -1 "$f" 2>/dev/null); case "$l" in SWEEP:NOMINAL*) printf "%s ops: %s\n" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$l"; exit 1 ;; esac; exit 0'
# Repair the wiring on every pass. A new store gets a new alert template that an install
# run months ago never saw; this is idempotent, costs a find and a diff, and is the
# cockpit-ensure lesson — repair from systemd, not from a session that may be dead.
ExecStartPre=-@SPIRA_PROD@/install-intake.sh install
# Anything the spool is still holding because the database was unreachable when the event
# arrived. A write-ahead record nobody drains is a lost event with extra steps.
ExecStartPre=-@SPIRA_PROD@/incident.sh drain
# THE PROMPT FILE IS WRITTEN BY WATCHTOWER. spira-watchtower.timer fires watchtower.sh on
# a thirty-minute cadence; it writes the snapshot to $SPIRA_RUN/ops-sweep-prompt.txt before
# this unit runs. Ops reads that file and enters sweep mode with it as the brief. If the
# file is absent (watchtower has not run since boot), this unit exits non-zero and systemd
# records a failure; the next tick will find the file present. That is the correct outcome:
# a sweep with no snapshot context produces no useful signal.
ExecStart=/bin/bash -c 'exec @SPIRA_PROD@/aeon.sh ops --sweep --prompt - < @SPIRA_RUN@/ops-sweep-prompt.txt'
# Matches FAYTH_TIMEOUT_SECONDS plus room for the sweep to start. An aeon that outlives
# this is killed and the next timer tick starts a fresh pass.
TimeoutStartSec=2000
# This box runs prod and the CI runner (law-fence-loops-on-shared-hardware).
CPUQuota=70%
Nice=10
StandardOutput=append:@SPIRA_RUN@/ops.log
StandardError=append:@SPIRA_RUN@/ops.log

[Install]
WantedBy=default.target
