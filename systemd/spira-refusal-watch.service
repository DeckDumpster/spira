[Unit]
Description=Spira refusal watch — files one bead per class of refused lifecycle transition over its baseline
After=default.target

[Service]
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=SPIRA_TOML=@SPIRA_TOML@
Environment=SPIRA_LC_PASSWORD_FILE=@SPIRA_LC_PASSWORD_FILE@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
Type=oneshot
Nice=19
CPUQuota=25%
ExecStart=@SPIRA_PROD_ROOT@/bin/refusal-watch pass --state @SPIRA_RUN@/refusal-watch.state --window-secs 86400 --baseline 5 --repeat-secs 86400 --max-files 10
# Exit 1 means a filing failed and is retried next pass; exit 3 (could not read the refusals) is a failure.
SuccessExitStatus=1
TimeoutStartSec=300
StandardOutput=append:@SPIRA_RUN@/refusal-watch.log
StandardError=append:@SPIRA_RUN@/refusal-watch.log

[Install]
WantedBy=default.target

[X-Spira]
Plane=observability
