[Unit]
Description=Spira reconciler flow pass — backlog trend, stage velocity, stage dwell, round health
Documentation=file://@SPIRA_HOME@/reconciler-flow/src/main.rs
After=default.target

[Service]
# THE LAUNCHER'S PATH, SET OUTRIGHT (sp-31gtu): the release this unit runs, and PATH built
# from it alone — nothing inherited from the user manager — so every tool invoked by bare
# name is that release's. Rendered from the release root (spira-releases/<sha>; the harness
# checkout's root until the release deploy lands).
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=SPIRA_TOML=@SPIRA_TOML@
Environment=SPIRA_LC_PASSWORD_FILE=@SPIRA_LC_PASSWORD_FILE@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
Type=oneshot
ExecStart=@SPIRA_PROD_ROOT@/bin/reconciler-flow --pass
# A pass runs a handful of duckdb queries over run/tsd/, one bd list and at most one mail
# send per gap. 60s is generous for all of that on a quiet box.
TimeoutStartSec=60
Environment=SPIRA_HOME=@SPIRA_PROD@
Environment=SPIRA_RUN=@SPIRA_RUN@
Environment=SPIRA_DB=@SPIRA_DB@
StandardOutput=append:@SPIRA_RUN@/reconciler-flow.log
StandardError=append:@SPIRA_RUN@/reconciler-flow.log

[Install]
WantedBy=default.target

[X-Spira]
Plane=work
