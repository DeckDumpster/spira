[Unit]
# The one Dolt server behind every beads database, including Spira's.
#
# WHY THIS UNIT EXISTS. The server used to be started by `gt dolt start`, out of
# a predecessor harness — a data directory inside the harness Spira replaced. Nothing
# restarted it: the process running on 2026-09-05 had been up since 2026-08-25 because
# nobody had rebooted, not because anything supervised it. The store now lives at
# @SPIRA_DOLT_DATA@ and this unit owns it, so a crash or a reboot brings it back instead of
# presenting as "bd hangs" to whatever runs next.
#
# The config is dolt-server.yaml, NOT config.yaml, on purpose: `gt dolt start` regenerates
# config.yaml in its data directory and overwrites it without warning. A name it does not
# know cannot be clobbered by a command nobody should still be running.
Description=Dolt SQL server for beads (spira and the frozen Gas Town databases)
Documentation=file://@SPIRA_HOME@/README.md
After=default.target
StartLimitIntervalSec=60
StartLimitBurst=5
# RefuseManualStop: `systemctl stop`/`restart` on this unit is denied (sp-39gqq — two
# aeons stopped the live store on 2026-09-25 by running suites on the host). install.sh's
# own restart path uses `kill` instead, which Restart=always turns into a restart without
# ever asking systemd for a stop job (sp-hsnqk). To stop it deliberately: `systemctl --user
# edit dolt-beads.service`, add `RefuseManualStop=no` under `[Unit]`, `daemon-reload`, then
# `stop`; `systemctl --user revert dolt-beads.service` restores the guard afterward.
RefuseManualStop=yes

[Service]
# THE LAUNCHER'S PATH, SET OUTRIGHT (sp-31gtu): the release this unit runs, and PATH built
# from it alone — nothing inherited from the user manager — so every tool invoked by bare
# name is that release's. Rendered from the release root (spira-releases/<sha>; the harness
# checkout's root until the release deploy lands).
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:/usr/local/bin:/usr/bin:/bin
Type=simple
ExecStart=@DOLT@ sql-server --config @SPIRA_DOLT_DATA@/dolt-server.yaml
WorkingDirectory=@SPIRA_DOLT_DATA@
Restart=always
RestartSec=5
# Dolt flushes its working set on SIGTERM; killing it early is how a store gets a dirty
# chunk journal. Give it room, and never SIGKILL the group out from under a flush.
KillSignal=SIGTERM
TimeoutStopSec=120
StandardOutput=append:@SPIRA_RUN@/dolt-beads.log
StandardError=append:@SPIRA_RUN@/dolt-beads.log

[Install]
WantedBy=default.target
