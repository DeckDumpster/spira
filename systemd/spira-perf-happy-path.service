[Unit]
Description=Spira perf-watch — time the sim happy path against its design goal, outside any round
Documentation=file://@SPIRA_HOME@/perf-probes
After=default.target

[Service]
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=SPIRA_TOML=@SPIRA_TOML@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
Type=oneshot
CPUQuota=50%
WorkingDirectory=@SPIRA_REPO@
ExecStart=@SPIRA_RELEASE@/bin/perf-watch happy --repo @SPIRA_REPO@ --sim @SPIRA_RELEASE@/bin/sim --scratch @SPIRA_RUN@/perf-happy-path --history @SPIRA_RUN@/perf-happy-path.history
TimeoutStartSec=420
StandardOutput=append:@SPIRA_RUN@/perf-watch.log
StandardError=append:@SPIRA_RUN@/perf-watch.log

[Install]
WantedBy=default.target

[X-Spira]
Plane=observability
