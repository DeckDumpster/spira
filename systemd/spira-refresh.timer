[Unit]
Description=Check every minute for a watcher running code older than the file on disk

[Timer]
# ONE MINUTE, because the window this closes is the one in which an agent is reading a
# watcher that has already been fixed. A pass costs a `systemctl show` and a `stat` and
# writes nothing when everything is current, so the cadence is bounded by the cost of being
# wrong rather than by the cost of asking.
OnBootSec=90
OnActiveSec=90
OnUnitActiveSec=1min
AccuracySec=15s
Unit=spira-refresh.service

[Install]
WantedBy=timers.target

[X-Spira]
Plane=observability
