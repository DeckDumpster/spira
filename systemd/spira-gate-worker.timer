[Unit]
Description=Spira gate worker — looks for queued gates every 30 seconds

[Timer]
# An idle tick takes a worker slot, finds an empty inbox and exits; a busy tick's workers
# hold every one of the certify_par slots, so a tick that lands mid-drain exits at once.
OnBootSec=60s
OnActiveSec=60s
OnUnitActiveSec=30s
AccuracySec=5s
Unit=spira-gate-worker.service

[Install]
WantedBy=timers.target

[X-Spira]
Plane=work
