[Unit]
Description=Spira mail tidy — archive answered, closed and stale mail from operator inbox
Documentation=file://@SPIRA_HOME@/mail.sh
After=default.target

[Service]
Type=oneshot
ExecStart=@SPIRA_PROD@/mail.sh tidy operator
TimeoutStartSec=120
StandardOutput=append:@SPIRA_RUN@/mail-tidy.log
StandardError=append:@SPIRA_RUN@/mail-tidy.log

[Install]
WantedBy=default.target
