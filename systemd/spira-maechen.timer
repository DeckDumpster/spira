[Unit]
Description=Evaluate Maechen trigger conditions every 15 minutes

[Timer]
# FIFTEEN MINUTES. The two conditions are a 25-landing count and a 3-hour time gap.
# A 15-minute interval gives 12 checks per 3-hour window, so the time trigger fires
# within 15 minutes of the gap being reached. The landing trigger is similarly prompt:
# at the measured rate of ~6 landings/hour, 25 landings accumulate in ~4 hours and the
# trigger detects them at the next 15-minute tick.
#
# THE INTERVAL IS THE ONLY PLACE THE CADENCE IS WRITTEN. Nothing reads a
# SPIRA_MAECHEN_TRIGGER_EVERY key because none exists; the two configuration keys
# (SPIRA_MAECHEN_LANDING_INTERVAL, SPIRA_MAECHEN_MAX_GAP_SECONDS) govern the
# thresholds, not the check frequency.
OnBootSec=15min
OnActiveSec=15min
OnUnitActiveSec=15min
AccuracySec=2min
Unit=spira-maechen.service

[Install]
WantedBy=timers.target

[X-Spira]
Plane=work
