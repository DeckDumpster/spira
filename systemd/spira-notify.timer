[Unit]
Description=Ask on a cadence whether any watcher's events have gone unread

[Timer]
# WELL UNDER SPIRA_NOTIFY_AGE, and that is the only constraint on this number. The threshold
# decides how long an event may wait; this decides the granularity with which that threshold
# is noticed, so a period near it would double the real wait. It is not a repetition rate for
# the alert: the escalation is suppressed while one backlog stands, so asking more often
# costs a `grep` and never a second ask.
OnBootSec=5min
OnActiveSec=5min
OnUnitActiveSec=5min
# Loose. Nothing downstream is waiting on the answer within a minute of its being due, and a
# wide window lets the service manager batch this with whatever else is scheduled.
AccuracySec=1min
# A box that was asleep or off still has the backlog when it comes back, and the event in it
# is older rather than less interesting.
Persistent=true
Unit=spira-notify.service

[Install]
WantedBy=timers.target

[X-Spira]
Plane=observability
