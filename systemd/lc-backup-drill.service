[Unit]
Description=Prove the newest off-box backups restore (lc-backup drill)
Documentation=file://@SPIRA_HOME@/lc-backup.sh
Wants=lc-backup.service
After=lc-serve.service dolt-beads.service lc-backup.service
# A release that changes the backup or restore logic, or the control store's schema, starts this
# unit at activation (release::activate), so the drill restores a backup the new code wrote.
X-Spira-StartWhenChanged=spira/lc-backup.sh spira-lc/src/durability.rs state-store-sqlite/src/durability/ state-store-sqlite/src/migrations.rs
X-Spira-NoDrain=true

[Service]
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=SPIRA_TOML=@SPIRA_TOML@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:@SPIRA_ENV_PATH@:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
Type=oneshot
ExecStart=@SPIRA_HOME@/lc-backup.sh drill
ExecStopPost=@SPIRA_HOME@/lc-backup.sh explain-drill
TimeoutStartSec=8h
IOSchedulingClass=idle
IOWeight=10
Nice=19
CPUQuota=50%
StandardOutput=append:@SPIRA_RUN@/lc-backup.log
StandardError=append:@SPIRA_RUN@/lc-backup.log
