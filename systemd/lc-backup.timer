[Unit]
Description=Back up the lifecycle stores every twelve hours

[Timer]
# Twice a day: the off-box recovery point is at most twelve hours old (SPIRA_LC_BACKUP_MAX_AGE is
# this interval plus two hours of slack).
OnCalendar=*-*-* 02,14:35:00
Persistent=true
AccuracySec=5min
RandomizedDelaySec=300
Unit=lc-backup.service

[Install]
WantedBy=timers.target
