[Unit]
# gh-intake fetches open issues from SPIRA_GH_INTAKE_REPO and runs them
# through a triage gate: OWNER/MEMBER/COLLABORATOR authors become work beads;
# everyone else gets an untrusted record and a daily digest. Promotion via
# spira:accept requires the actor to currently have admin/maintain/write access,
# verified at promotion time against the collaborators API.
#
# gh-intake reads SPIRA_GH_INTAKE_REPO (and its siblings) from its own process
# environment, the same as every other Rust-ported unit here (czar-pass,
# sentinel, ...): whatever resolves spira.toml into the systemd user session's
# environment supplies it, not this unit's own Environment= lines. Unset, it
# logs one line and exits 0, keeping the unit inert on installs with no
# configured inbox.
Description=Spira GitHub issue intake — triage gate
After=default.target

[Service]
# THE LAUNCHER'S PATH, SET OUTRIGHT (sp-31gtu): the release this unit runs, and PATH built
# from it alone — nothing inherited from the user manager — so every tool invoked by bare
# name is that release's. Rendered from the release root (spira-releases/<sha>; the harness
# checkout's root until the release deploy lands).
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
Type=oneshot
ExecStart=@SPIRA_PROD_ROOT@/bin/gh-intake
TimeoutStartSec=120
StandardOutput=append:@SPIRA_RUN@/gh-intake.log
StandardError=append:@SPIRA_RUN@/gh-intake.log

[Install]
WantedBy=default.target

[X-Spira]
Plane=work
