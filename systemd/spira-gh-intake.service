[Unit]
# gh-intake.sh fetches open issues from SPIRA_GH_INTAKE_REPO and runs them
# through a triage gate: OWNER/MEMBER/COLLABORATOR authors become work beads;
# everyone else gets an untrusted record and a daily digest. Promotion via
# spira:accept requires the actor to currently have admin/maintain/write access,
# verified at promotion time against the collaborators API.
#
# ExecCondition makes the unit inert until SPIRA_GH_INTAKE_REPO is configured.
# A timer firing without a configured inbox would abort every pass with an error.
Description=Spira GitHub issue intake — triage gate
After=default.target

[Service]
Type=oneshot
ExecCondition=/bin/sh -c 'test -n "${SPIRA_GH_INTAKE_REPO:-}"'
ExecStart=@SPIRA_PROD@/gh-intake.sh
TimeoutStartSec=120
CPUQuota=10%
Nice=10
StandardOutput=append:@SPIRA_RUN@/gh-intake.log
StandardError=append:@SPIRA_RUN@/gh-intake.log

[Install]
WantedBy=default.target
