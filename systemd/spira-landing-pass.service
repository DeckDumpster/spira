[Unit]
Description=Spira landing pass — pr mode (the gated modes run as landing-pass land under spira-landing)
Documentation=file://@SPIRA_HOME@/../landing-pass/src/pr_branch.rs
After=default.target

[Service]
# THE LAUNCHER'S PATH, SET OUTRIGHT (sp-31gtu): the release this unit runs, and PATH built
# from it alone — nothing inherited from the user manager — so every tool invoked by bare
# name is that release's. Rendered from the release root (spira-releases/<sha>; the harness
# checkout's root until the release deploy lands).
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
Type=oneshot
ExecStart=@SPIRA_PROD_ROOT@/bin/landing-pass --pass
# A pass enumerates repos, rebases branches, and pushes/opens pull requests.
# No gate.sh, no container — bounded in seconds under normal load.
TimeoutStartSec=120
Environment=SPIRA_HOME=@SPIRA_PROD@
Environment=SPIRA_RUN=@SPIRA_RUN@
Environment=SPIRA_DB=@SPIRA_DB@
StandardOutput=append:@SPIRA_RUN@/landing-pass.log
StandardError=append:@SPIRA_RUN@/landing-pass.log

[Install]
WantedBy=default.target
