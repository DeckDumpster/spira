[Unit]
# The concierge is the phone's only way in; "always available" is the whole property.
# `concierge.sh start` is idempotent and backgrounds a tmux server, so systemd cannot
# supervise it as a main process — this is an ensure on a timer, replacing the cron
# */10 and @reboot pair.
Description=Ensure the Remote Control concierge session is up
Documentation=file://@SPIRA_PROD_ROOT@/concierge.sh
After=default.target

[Service]
# THE LAUNCHER'S PATH, SET OUTRIGHT (sp-31gtu): the release this unit runs, and PATH built
# from it alone — nothing inherited from the user manager — so every tool invoked by bare
# name is that release's. Rendered from the release root (spira-releases/<sha>; the harness
# checkout's root until the release deploy lands).
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=SPIRA_TOML=@SPIRA_TOML@
Environment=SPIRA_LC_PASSWORD_FILE=@SPIRA_LC_PASSWORD_FILE@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
Type=oneshot
ExecStart=@SPIRA_PROD_ROOT@/concierge.sh start
TimeoutStartSec=60
StandardOutput=append:@SPIRA_RUN@/concierge.log
StandardError=append:@SPIRA_RUN@/concierge.log

[Install]
WantedBy=default.target
