[Unit]
Description=Spira round template refresh — rebuild the round VM template when the landing ref's image tag changes
Documentation=file://@SPIRA_PROD_ROOT@/round-vm/DESIGN.md
After=default.target

[Service]
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=SPIRA_TOML=@SPIRA_TOML@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
Environment=SPIRA_HOME=@SPIRA_HOME@
Environment=SPIRA_RUN=@SPIRA_RUN@
Type=oneshot
ExecStart=@SPIRA_PROD_ROOT@/bin/round-vm refresh @SPIRA_REPO@ --ref local/main
TimeoutStartSec=3300
StandardOutput=append:@SPIRA_RUN@/round-template.log
StandardError=append:@SPIRA_RUN@/round-template.log

[X-Spira]
Plane=observability
