[Unit]
# The Loom server — a read endpoint over the live beads graph, with the page that draws it.
# One binary, two routes: GET /api/beads returns the graph; GET / returns the page.
Description=Loom — a read endpoint over the live beads graph
Documentation=file://@SPIRA_HOME@/loom.sh
After=default.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# @SPIRA_HOME@ (dev checkout), not @SPIRA_PROD@. The loom binary is a compiled Rust artifact
# at $SPIRA_REPO/loom/target/release/loom — gitignored and not cloned into the prod checkout.
# loom.sh is an 8-line wrapper exec'd in one shot, not read incrementally, so it does not have
# the partial-execution hazard that makes aeon.sh and sentinel.sh run from the prod checkout.
# Running from @SPIRA_HOME@ sets SPIRA_REPO = dev checkout root, where the binary is built.
ExecStart=@SPIRA_HOME@/loom.sh
Restart=always
# The MINIMUM time between restarts. A crash loop is visible in the log; a 5-second floor
# keeps it from chewing CPU while remaining fast to recover from a transient.
RestartSec=5
# Loom answers queries, not sends them. A quota exists because it shares hardware with the
# loop and CI (law-fence-loops-on-shared-hardware); 20% is enough for a query every 15s.
CPUQuota=20%
Nice=10
StandardOutput=append:@SPIRA_RUN@/loom.log
StandardError=append:@SPIRA_RUN@/loom.log

[Install]
WantedBy=default.target
