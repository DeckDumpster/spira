[Unit]
Description=Back up the lifecycle store off-box, then prove the copy restores
Documentation=file://@SPIRA_HOME@/lc-backup.sh
After=lc-serve.service dolt-beads.service

[Service]
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=SPIRA_TOML=@SPIRA_TOML@
EnvironmentFile=-%h/.config/lc-backup.env
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
Type=oneshot
ExecStart=@SPIRA_HOME@/lc-backup.sh run
ExecStartPost=@SPIRA_HOME@/lc-backup.sh drill
TimeoutStartSec=1800
IOSchedulingClass=idle
Nice=19
CPUQuota=50%
StandardOutput=append:@SPIRA_RUN@/lc-backup.log
StandardError=append:@SPIRA_RUN@/lc-backup.log

[Install]
WantedBy=default.target
