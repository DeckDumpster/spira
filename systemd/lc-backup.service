[Unit]
Description=Back up the lifecycle stores off-box
Documentation=file://@SPIRA_HOME@/lc-backup.sh
After=lc-serve.service dolt-beads.service

[Service]
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=SPIRA_TOML=@SPIRA_TOML@
EnvironmentFile=-%h/.config/lc-backup.env
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:@SPIRA_ENV_PATH@:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
Type=oneshot
ExecStart=@SPIRA_HOME@/lc-backup.sh run
ExecStopPost=@SPIRA_HOME@/lc-backup.sh explain
# Sized to the work at this unit's own CPU quota: the bd snapshot's compaction (restore, dolt gc,
# re-sync; ~15 CPU-minutes, sp-lcptkd) takes ~30 wall-minutes at CPUQuota=50%, before the raw
# sync and the upload. 1800 killed the 2026-11-02 08:39 run at 30m09s with 14m36s of CPU used.
TimeoutStartSec=5400
IOSchedulingClass=idle
Nice=19
CPUQuota=50%
StandardOutput=append:@SPIRA_RUN@/lc-backup.log
StandardError=append:@SPIRA_RUN@/lc-backup.log

[Install]
WantedBy=default.target
