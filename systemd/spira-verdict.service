[Unit]
Description=Spira verdict — settle open merge-queue batches
Documentation=file://@SPIRA_HOME@/spira-verdict.sh
After=default.target

[Service]
Type=oneshot
ExecStart=@SPIRA_PROD@/spira-verdict.sh
# TimeoutStartSec covers the longest legitimate job: a red batch replays each member
# in a container, which takes several minutes per member at full CPU. 3600s matches
# the CI-run ceiling (SPIRA_QUEUE_CI_MAXSEC). CPUQuota is absent: throttling the
# poller is fine; throttling the replay containers that run inside it is not.
TimeoutStartSec=3600
Nice=10
StandardOutput=append:@SPIRA_RUN@/verdict.log
StandardError=append:@SPIRA_RUN@/verdict.log

[Install]
WantedBy=default.target
