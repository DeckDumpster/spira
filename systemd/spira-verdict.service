[Unit]
Description=Spira verdict — settle open merge-queue batches
Documentation=file://@SPIRA_PROD_ROOT@/queue/DESIGN.md
After=default.target

[Service]
# THE LAUNCHER'S PATH, SET OUTRIGHT (sp-31gtu): the release this unit runs, and PATH built
# from it alone — nothing inherited from the user manager — so every tool invoked by bare
# name is that release's. Rendered from the release root (spira-releases/<sha>; the harness
# checkout's root until the release deploy lands).
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:/usr/local/bin:/usr/bin:/bin
Type=oneshot
ExecStart=@SPIRA_PROD_ROOT@/bin/queue step --all
# The binary finds lib.sh through SPIRA_HOME; the script it replaced found it beside itself.
Environment=SPIRA_HOME=@SPIRA_PROD@
# TimeoutStartSec covers the longest legitimate job: a red batch replays each member
# in a container, which takes several minutes per member at full CPU. 3600s matches
# the CI-run ceiling (SPIRA_QUEUE_CI_MAXSEC).
TimeoutStartSec=3600
StandardOutput=append:@SPIRA_RUN@/verdict.log
StandardError=append:@SPIRA_RUN@/verdict.log

[Install]
WantedBy=default.target
