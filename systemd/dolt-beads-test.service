[Unit]
# A SECOND Dolt server, for test fixtures only, so the suites never touch the live one.
#
# WHY THIS UNIT EXISTS. Every fixture used to be a database on the production server —
# `bd init --server --external` against the store holding spira and every real database.
# Three things followed, and all three cost a day on 2026-09-07:
#
#   1. FIXTURES LEAKED INTO PRODUCTION. A suite killed by `timeout`, a stopped unit or a
#      slain aeon never runs its trap, so its database stayed. Twenty-four had accumulated.
#   2. EVERY LEAK SLOWED THE REAL SERVER. A fixture build measured 6s against an empty
#      server, 84s against production, and 180s with 34 databases present.
#   3. THE CLEANUP BECAME THE STORM. An age-based sweep ran on every build, unbounded and
#      concurrent — ~144 DROP DATABASE for six builds — which pushed builds past the
#      server's read timeout and killed connections mid-migration.
#
# WHY A SECOND SERVER RATHER THAN EMBEDDED OR PROXIED. Embedded needs a CGO build and this
# binary is CGO_ENABLED=0 (sp-unxg). Proxied was measured and rejected: `bd import` and
# `bd recompute-blocked` are both unsupported there, and test-sentinel exercises the second
# through the sentinel itself. A separate server keeps every bd command working and changes
# only WHERE the fixtures live.
#
# ITS STORE IS DISPOSABLE, and that is the point. Nothing here is data. If it is wiped, the
# next suite rebuilds what it needs, so a leak is no longer a slow poison — it is garbage on
# a disk nobody reads.
#
# ON-DEMAND: this unit is NOT enabled at login (no WantedBy=default.target). testdb.sh starts
# it before its first use and stops it after the last test fixture is dropped. On boxes where
# embedded bd is available, testdb.sh uses that instead and never starts this unit at all.
# KillSignal=SIGTERM and TimeoutStopSec=120 are load-bearing: dolt writes its working set
# on SIGTERM, and a store killed early has a dirty chunk journal.
Description=Dolt SQL server for test fixtures (disposable; never holds real data)
Documentation=file://@SPIRA_HOME@/README.md
After=default.target

[Service]
Type=simple
ExecStart=@DOLT@ sql-server --config @SPIRA_TESTDB_DATA@/dolt-server.yaml
WorkingDirectory=@SPIRA_TESTDB_DATA@
# No Restart= here: testdb.sh owns the lifecycle. A restart policy would fight the stop
# that testdb_drop issues when the last fixture is dropped.
KillSignal=SIGTERM
TimeoutStopSec=120
# Half the production server's ceiling. Fixtures are bursty and this box also runs prod, CI
# and the operator's session (law-fence-loops-on-shared-hardware).
CPUQuota=50%
Nice=10
StandardOutput=append:@SPIRA_RUN@/dolt-beads-test.log
StandardError=append:@SPIRA_RUN@/dolt-beads-test.log

[Install]
# Intentionally empty: this unit is installed (so systemctl start works) but never enabled
# (no WantedBy=default.target). Script activation from testdb.sh replaces always-on.
