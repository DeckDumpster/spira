[Unit]
Description=Spira event continuity — the first break per key in the lifecycle event log
After=default.target

[Service]
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=SPIRA_TOML=@SPIRA_TOML@
Environment=SPIRA_LC_PASSWORD_FILE=@SPIRA_LC_PASSWORD_FILE@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
Type=oneshot
ExecStart=@SPIRA_PROD_ROOT@/bin/spira-lc event-continuity
TimeoutStartSec=60
StandardOutput=append:@SPIRA_RUN@/event-continuity.log
StandardError=append:@SPIRA_RUN@/event-continuity.log

[Install]
WantedBy=default.target

[X-Spira]
Plane=observability
