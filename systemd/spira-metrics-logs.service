[Unit]
Description=VictoriaLogs — the wide-event store
Documentation=file://@SPIRA_HOME@/metrics-stack.sh
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=SPIRA_TOML=@SPIRA_TOML@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:@SPIRA_ENV_PATH@:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
Type=simple
ExecStart=@SPIRA_PROD@/metrics-stack.sh logs
CPUQuota=100%
SuccessExitStatus=2
Restart=always
RestartSec=30
StandardOutput=append:@SPIRA_RUN@/spira-metrics-logs.log
StandardError=append:@SPIRA_RUN@/spira-metrics-logs.log

[X-Spira]
Plane=observability

[Install]
WantedBy=default.target
