[Unit]
After=lc-serve.service
Wants=lc-serve.service
Description=Spira escape census — escapes by class over the trailing week
Documentation=file://@SPIRA_HOME@/escape-classify.sh

[Service]
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=SPIRA_TOML=@SPIRA_TOML@
Environment=SPIRA_LC_PASSWORD_FILE=@SPIRA_LC_PASSWORD_FILE@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:@SPIRA_ENV_PATH@:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
Type=oneshot
ExecStart=@SPIRA_PROD@/escape-classify.sh census
TimeoutStartSec=120
StandardOutput=append:@SPIRA_RUN@/escape-census.log
StandardError=append:@SPIRA_RUN@/escape-census.log

[Install]
WantedBy=default.target

[X-Spira]
Plane=observability
