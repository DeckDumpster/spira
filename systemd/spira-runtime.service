[Unit]
Description=Spira runtime — the long-running host of the loop's workflows (heartbeat, wide events, stall quarantine)
After=lc-serve.socket
Wants=lc-serve.socket
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=SPIRA_TOML=@SPIRA_TOML@
Environment=SPIRA_HOME=@SPIRA_PROD@
Environment=SPIRA_RUN=@SPIRA_RUN@
# Where this instance keeps its store, named on the unit so a reinstall can read them off it
# (docs/reinstall-runbook.md, step 2a). The values are the config file's own.
Environment=SPIRA_DB=@SPIRA_DB@
Environment=SPIRA_DOLT_DATA=@SPIRA_DOLT_DATA@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:@SPIRA_ENV_PATH@:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
# Type=notify, and the dispatch loop itself sends WATCHDOG=1: a hung handler stops the kicks
# and systemd restarts the service; the in-flight marker then quarantines a call that stalls twice.
Type=notify
ExecStart=@SPIRA_PROD_ROOT@/bin/spira-runtime serve
Restart=always
RestartSec=5
WatchdogSec=30
StandardOutput=append:@SPIRA_RUN@/spira-runtime.log
StandardError=append:@SPIRA_RUN@/spira-runtime.log

[X-Spira]
Plane=observability

[Install]
WantedBy=default.target
