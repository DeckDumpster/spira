[Unit]
# One template for every subscriber: the instance name is the subscriber's, and install's
# manifest names them. A reader attaches to the running client (`spira-sub follow`).
Description=Spira subscriber %i
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=SPIRA_TOML=@SPIRA_TOML@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:@SPIRA_ENV_PATH@:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
Type=simple
# It waits for the broker by itself, and logs only what went wrong.
ExecStart=@SPIRA_PROD_ROOT@/bin/spira-sub run --as %i
Restart=always
RestartSec=30

[Install]
WantedBy=default.target

[X-Spira]
Plane=observability
