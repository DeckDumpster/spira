[Unit]
Description=Sweep queue-mode repositories for stranded branches and worktrees once a day

[Timer]
# ONCE A DAY. A queue-mode repo's landed branches are reaped at landing itself
# (the queue's own close, recorded on spira-lc), so this is a backstop for what that path missed — a branch held at
# the moment of landing, a repo:/branch: label that failed to resolve — not the primary
# reaper. Offset from midnight so it does not compete with the other daily jobs at :00.
OnCalendar=*-*-* 04:35:00
Persistent=true
AccuracySec=5min
RandomizedDelaySec=300
Unit=spira-straggler-sweep.service

[Install]
WantedBy=timers.target

[X-Spira]
Plane=work
