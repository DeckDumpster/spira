[Unit]
Description=Sweep every repository for branches of finished beads every hour

[Timer]
# Hourly, so a repository nothing else sweeps never accumulates a backlog; each pass is
# bounded by the service's time budget.
OnCalendar=*-*-* *:35:00
Persistent=true
AccuracySec=5min
RandomizedDelaySec=300
Unit=spira-straggler-sweep.service

[Install]
WantedBy=timers.target

[X-Spira]
Plane=work
