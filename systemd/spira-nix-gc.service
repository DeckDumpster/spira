[Unit]
Description=Collect unreferenced Nix store paths, keeping the current and previous spira-env
After=default.target

[Service]
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=SPIRA_TOML=@SPIRA_TOML@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:@SPIRA_ENV_PATH@:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
Type=oneshot
ExecStart=@SPIRA_PROD@/nix-gc.sh
TimeoutStartSec=1800
CPUQuota=20%
Nice=10
IOSchedulingClass=idle
StandardOutput=append:@SPIRA_RUN@/nix-gc.log
StandardError=append:@SPIRA_RUN@/nix-gc.log

[Install]
WantedBy=default.target

[X-Spira]
Plane=maintenance
