[Unit]
Description=Spira gate worker — gates the branches the landing pass queued, up to certify_par at once
Documentation=file://@SPIRA_HOME@/../gate-worker/src/lib.rs
After=default.target

[Service]
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=SPIRA_LC_PASSWORD_FILE=@SPIRA_LC_PASSWORD_FILE@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
Type=oneshot
ExecStart=@SPIRA_PROD_ROOT@/bin/gate-worker run
# A gate is bounded by SPIRA_GATE_TIMEOUT per trial and each worker drains a queue of them
# one at a time; this one process fans out to up to certify_par worker slots (spawning
# certify_par-1 helper copies of itself and waiting on them) and each slot's own numbered
# lock (worker.lock, worker.lock.1, ...) is what keeps two slots from ever taking the same
# job (sp-kbjv6 "wave N concurrent drains"). A tick landing while an earlier tick's workers
# are still draining finds every slot taken and exits at once, same as before.
TimeoutStartSec=infinity
Environment=SPIRA_HOME=@SPIRA_PROD@
Environment=SPIRA_RUN=@SPIRA_RUN@
Environment=SPIRA_DB=@SPIRA_DB@
StandardOutput=append:@SPIRA_RUN@/gate-worker.log
StandardError=append:@SPIRA_RUN@/gate-worker.log

[Install]
WantedBy=default.target

[X-Spira]
Plane=work
