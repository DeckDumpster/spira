[Unit]
Description=Spira watchtower — hand Ops the state of the pipeline
Documentation=file://@SPIRA_HOME@/watchtower.sh

[Service]
Type=oneshot
ExecStart=@SPIRA_PROD@/watchtower.sh
TimeoutStartSec=120
Environment=SPIRA_HOME=@SPIRA_PROD@
Environment=SPIRA_RUN=@SPIRA_RUN@
StandardOutput=append:@SPIRA_RUN@/watchtower.log
StandardError=append:@SPIRA_RUN@/watchtower.log
