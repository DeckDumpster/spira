[Unit]
After=lc-serve.service
Wants=lc-serve.service
Description=Spira reconciler — structural invariants: fleet, units, store, cockpit, release, disk, queue
Documentation=file://@SPIRA_HOME@/reconciler/src/main.rs
After=default.target

[Service]
# THE LAUNCHER'S PATH, SET OUTRIGHT (sp-31gtu): the release this unit runs, and PATH built
# from it alone — nothing inherited from the user manager — so every tool invoked by bare
# name is that release's. Rendered from the release root (spira-releases/<sha>; the harness
# checkout's root until the release deploy lands).
Environment=SPIRA_RELEASE=@SPIRA_RELEASE@
Environment=SPIRA_TOML=@SPIRA_TOML@
Environment=SPIRA_LC_PASSWORD_FILE=@SPIRA_LC_PASSWORD_FILE@
Environment=PATH=@SPIRA_RELEASE@/bin:@SPIRA_RELEASE@/spira:/usr/local/bin:/usr/bin:/bin@SPIRA_PATH_TAIL@
Type=oneshot
ExecStart=@SPIRA_PROD_ROOT@/bin/reconciler --pass
# A loaded pass runs past 60 s and was killed before it wrote reconciler-pass.stamp; the
# flock in --pass stops overlap, so the budget need only exceed the longest observed pass.
TimeoutStartSec=300
Environment=SPIRA_HOME=@SPIRA_PROD@
Environment=SPIRA_RUN=@SPIRA_RUN@
StandardOutput=append:@SPIRA_RUN@/reconciler.log
StandardError=append:@SPIRA_RUN@/reconciler.log

[Install]
WantedBy=default.target

[X-Spira]
Plane=work
