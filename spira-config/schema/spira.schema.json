{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpiraToml",
  "description": "The root of `spira.toml`.",
  "type": "object",
  "properties": {
    "persona": {
      "default": {},
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/PersonaSection"
      }
    },
    "repo": {
      "default": {},
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/RepoSection"
      }
    },
    "spira": {
      "anyOf": [
        {
          "$ref": "#/definitions/SpiraSection"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "CzarStage": {
      "description": "A czar stage: shadow investigates and writes CZAR-WOULD notes; act permits mutation. One representative key (`czar_stage_deadlock`) ships here — the other six `SPIRA_CZAR_STAGE_*` classes are the same enum and widen with the rest of `[spira]`.",
      "type": "string",
      "enum": [
        "shadow",
        "act"
      ]
    },
    "GateMode": {
      "description": "`[repo.<name>] gate_mode` — how the gate composes a trial (gate/DESIGN.md \"Composition\").\n\n* `suites` (the default): the repository's gate string, whole — fences, build, and the budgeted suite selection. * `unit`: the composition follows what the branch touches. A branch that touches any bash (or other script) component still runs the gate string whole; one that touches only Rust crates (plus docs, config, suites) runs the fences with suites off, then `cargo test -p` for each touched crate and its reverse dependents on the host; one that touches nothing buildable runs the fences only.\n\nOne command reverts it: `spira-config set repo.<name>.gate_mode suites <file>`.",
      "type": "string",
      "enum": [
        "unit",
        "suites"
      ]
    },
    "LandMode": {
      "description": "How a landed branch reaches its base — see `repo-map.example`'s own `land` column. `Queue` and `QueueForge` are the same mode under two spellings — `queue` is the alias a row has always been able to write, `queue.forge` names it explicitly now that `QueueLocal` exists to contrast it with. `QueueLocal` lands on a local branch (`local/main` in the `base` column) with no forge round trip on the critical path.",
      "type": "string",
      "enum": [
        "push",
        "pr",
        "hold",
        "queue",
        "queue.forge",
        "queue.local"
      ]
    },
    "Lane": {
      "description": "A persona lane a repository admits — the explicit form of `repo-map.example`'s `lanes` column. A row's shorthand mode (`consume`/`develop`/`self`) is expanded to this array by the converter; the schema itself only ever sees the expanded list.",
      "type": "string",
      "enum": [
        "plan",
        "incident",
        "groom",
        "maechen-sweep",
        "spike",
        "czar-trigger"
      ]
    },
    "Lease": {
      "description": "The claim TTL and heartbeat cadence a persona's lease runs on.",
      "type": "object",
      "properties": {
        "heartbeat_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "minutes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "OnOff": {
      "description": "on/off, spelled as an enum rather than a bool so a TOML reader sees the word `spira.conf` already used (`SPIRA_CERTIFY_SUITES = off`) instead of learning a second spelling for it.",
      "type": "string",
      "enum": [
        "on",
        "off"
      ]
    },
    "PersonaSection": {
      "description": "`[persona.<name>]` — a fayth, cut down to what the harness itself reads to summon and dispatch it. `model` is the one field with no sensible default: an aeon summoned under no model is not a cheaper aeon, it is a dead one, so it is required.",
      "type": "object",
      "required": [
        "model"
      ],
      "properties": {
        "labels": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lane": {
          "type": [
            "string",
            "null"
          ]
        },
        "lease": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/Lease"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "type": "string"
        },
        "system_prompt": {
          "anyOf": [
            {
              "$ref": "#/definitions/SystemPromptMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "tools": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "RepoSection": {
      "description": "`[repo.<name>]` — a checkout the harness may work in. `path` and `mode` are the two facts nothing can derive: where the checkout is, and what a green gate does with a branch. Everything else has a sensible empty reading (no format, no explicit base to resolve, no extra lanes).",
      "type": "object",
      "required": [
        "mode",
        "path"
      ],
      "properties": {
        "base": {
          "type": [
            "string",
            "null"
          ]
        },
        "forge": {
          "description": "Overrides the host's default forge script for this one repository. Absent means \"use `[spira]`'s own\", which is every repository today.",
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "type": [
            "string",
            "null"
          ]
        },
        "gate_mode": {
          "description": "What the certification gate runs for this repository (design gate-unit-round-integration-2026-09-29, item 4, sp-2ghui). Absent means [`GateMode::Suites`], today's behaviour exactly. Read it with [`RepoSection::gate_mode`].",
          "anyOf": [
            {
              "$ref": "#/definitions/GateMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "lanes": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/Lane"
          }
        },
        "mode": {
          "$ref": "#/definitions/LandMode"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
